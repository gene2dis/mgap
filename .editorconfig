root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_size = 4
indent_style = space

[*.{yml,yaml,html,css,scss,js,cff}]
indent_size = 2

# Markdown is formatted by prettier, whose ordered-list continuation indent
# (3 spaces) conflicts with any fixed indent_size - leave it to prettier
[*.md]
indent_size = unset

# Jupyter notebooks are machine-written JSON
[*.ipynb]
indent_size = unset

# These files are edited and tested upstream in nf-core/modules
[/modules/nf-core/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

[/assets/email*]
indent_size = unset

# Tool outputs used as parser fixtures: kept as the tools write them (Kraken2
# pads its columns with spaces, a TSV whose last column is empty ends in a
# tab; the fastp JSON is indented by 2, as prettier writes it)
[/tests/bin/data/*.{tsv,txt,tab,genome_size,json}]
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
