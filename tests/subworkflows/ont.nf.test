nextflow_workflow {

    name "Test ONT subworkflow"
    script "../../subworkflows/local/ont.nf"
    workflow "ONT"

    tag "subworkflows"
    tag "ont"

    test("ONT - long reads - stub") {

        tag "stub"

        options "-stub"

        when {
            params {
                seq_type        = "ont"
                flye_mode       = "nano-hq"
                run_kraken2     = false
                adjust_coverage = false
                run_dnaapler    = false  // dnaapler has no stub yet (MGAP-13)
                outdir          = "$outputDir"
            }
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:true ],
                    [ file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/prokaryotes/bacteroides_fragilis/nanopore/fastq/test.fastq.gz', checkIfExists: true) ]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.assembly }
            )
        }

    }

}
