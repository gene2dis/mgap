nextflow_workflow {

    name "Test COVERAGE_ADJUST subworkflow"
    script "../../subworkflows/local/coverage_adjust.nf"
    workflow "COVERAGE_ADJUST"

    tag "subworkflows"
    tag "coverage_adjust"

    // Coverage = fastp after_filtering.total_bases / Mash genome size. The
    // MASH_SKETCH stub reports 5,000,000 bp, so the fastp JSON decides the
    // branch at the default max_coverage of 150: 1 Gb is 200x (subsample),
    // 500 Mb is 100x (keep).

    test("COVERAGE_ADJUST - 200x above max_coverage, subsample - stub") {

        tag "stub"

        options "-stub"

        when {
            params {
                max_coverage = 150
                outdir       = "$outputDir"
            }
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ],
                    [ file("${baseDir}/tests/data/stub_inputs/reads_1.fastq.gz", checkIfExists: true), file("${baseDir}/tests/data/stub_inputs/reads_2.fastq.gz", checkIfExists: true) ]
                ])
                input[1] = Channel.of([
                    [ id:'test', single_end:false ],
                    file("${baseDir}/tests/data/fastp/deep.fastp.json", checkIfExists: true)
                ])
                """
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            assertAll(
                { assert workflow.success },
                { assert succeeded.any { it.contains('MASH_SKETCH') } },
                { assert succeeded.any { it.contains('SEQTK_SAMPLE') } },
                { assert workflow.out.reads.size() == 1 },
                // the reads now come from SEQTK_SAMPLE, not the input files
                { assert [ workflow.out.reads[0][1] ].flatten().every { !(it.tokenize('/').last() in [ 'reads_1.fastq.gz', 'reads_2.fastq.gz' ]) } }
            )
        }

    }

    test("COVERAGE_ADJUST - 100x within max_coverage, keep reads - stub") {

        tag "stub"

        options "-stub"

        when {
            params {
                max_coverage = 150
                outdir       = "$outputDir"
            }
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ],
                    [ file("${baseDir}/tests/data/stub_inputs/reads_1.fastq.gz", checkIfExists: true), file("${baseDir}/tests/data/stub_inputs/reads_2.fastq.gz", checkIfExists: true) ]
                ])
                input[1] = Channel.of([
                    [ id:'test', single_end:false ],
                    file("${baseDir}/tests/data/fastp/shallow.fastp.json", checkIfExists: true)
                ])
                """
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            assertAll(
                { assert workflow.success },
                { assert succeeded.any { it.contains('MASH_SKETCH') } },
                { assert !succeeded.any { it.contains('SEQTK_SAMPLE') } },
                { assert workflow.out.reads.size() == 1 },
                // the input files themselves, not copies from MASH_SKETCH's work directory
                { assert workflow.out.reads[0][1].collect { it.tokenize('/').last() } == [ 'reads_1.fastq.gz', 'reads_2.fastq.gz' ] },
                { assert workflow.out.reads[0][1].every { it.contains('/tests/data/stub_inputs/') } }
            )
        }

    }

    test("COVERAGE_ADJUST - unreadable fastp JSON, keep reads - stub") {

        tag "stub"

        options "-stub"

        when {
            params {
                max_coverage = 150
                outdir       = "$outputDir"
            }
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ],
                    [ file("${baseDir}/tests/data/stub_inputs/reads_1.fastq.gz", checkIfExists: true), file("${baseDir}/tests/data/stub_inputs/reads_2.fastq.gz", checkIfExists: true) ]
                ])
                input[1] = Channel.of([
                    [ id:'test', single_end:false ],
                    file("${baseDir}/tests/data/fastp/empty.fastp.json", checkIfExists: true)
                ])
                """
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            assertAll(
                { assert workflow.success },
                { assert !succeeded.any { it.contains('SEQTK_SAMPLE') } },
                { assert workflow.out.reads.size() == 1 },
                { assert path("$metaDir/nextflow.log").text.contains("Sample 'test': could not estimate read coverage") }
            )
        }

    }

}
