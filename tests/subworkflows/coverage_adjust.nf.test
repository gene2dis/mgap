nextflow_workflow {

    name "Test COVERAGE_ADJUST subworkflow"
    script "../../subworkflows/local/coverage_adjust.nf"
    workflow "COVERAGE_ADJUST"

    tag "subworkflows"
    tag "coverage_adjust"

    // The MASH_SKETCH stub always reports 100x coverage, so max_coverage
    // decides the branch: below 100 subsamples, at or above keeps the reads.

    test("COVERAGE_ADJUST - above max_coverage, subsample - stub") {

        tag "stub"

        options "-stub"

        when {
            params {
                max_coverage = 50
                outdir       = "$outputDir"
            }
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ],
                    [ file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/prokaryotes/bacteroides_fragilis/illumina/fastq/test1_1.fastq.gz', checkIfExists: true), file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/prokaryotes/bacteroides_fragilis/illumina/fastq/test1_2.fastq.gz', checkIfExists: true) ]
                ])
                """
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            assertAll(
                { assert workflow.success },
                { assert succeeded.any { it.contains('MASH_SKETCH') } },
                { assert succeeded.any { it.contains('SEQTK_SAMPLE') } },
                { assert workflow.out.reads.size() == 1 },
                // the SEQTK_SAMPLE stub writes <id>.fastq.gz in place of the input pair
                { assert [ workflow.out.reads[0][1] ].flatten().collect { it.tokenize('/').last() } == [ 'test.fastq.gz' ] }
            )
        }

    }

    test("COVERAGE_ADJUST - within max_coverage, keep reads - stub") {

        tag "stub"

        options "-stub"

        when {
            params {
                max_coverage = 150
                outdir       = "$outputDir"
            }
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ],
                    [ file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/prokaryotes/bacteroides_fragilis/illumina/fastq/test1_1.fastq.gz', checkIfExists: true), file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/prokaryotes/bacteroides_fragilis/illumina/fastq/test1_2.fastq.gz', checkIfExists: true) ]
                ])
                """
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            assertAll(
                { assert workflow.success },
                { assert succeeded.any { it.contains('MASH_SKETCH') } },
                { assert !succeeded.any { it.contains('SEQTK_SAMPLE') } },
                { assert workflow.out.reads.size() == 1 },
                { assert workflow.out.reads[0][1].collect { it.tokenize('/').last() } == [ 'test1_1.fastq.gz', 'test1_2.fastq.gz' ] }
            )
        }

    }

}
