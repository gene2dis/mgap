/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config for nf-test
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    The pipeline config plus resource caps that fit a GitHub-hosted runner
    (4 CPUs, 16 GB). Without them, process_medium asks for 6 CPUs and the local
    executor refuses the task ("Process requirement exceeds available CPUs").
----------------------------------------------------------------------------------------
*/

includeConfig '../nextflow.config'

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '6.h'
    ]
}
