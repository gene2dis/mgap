                { assert workflow.success },
                { assert annotation.tools == ['CHECKM2', 'MLST', 'GTDBTK', 'GENOMAD', 'MOBSUITE_RECON', 'RGI_MAIN'] as Set },
                { assert annotation.errors == [] }
            )
