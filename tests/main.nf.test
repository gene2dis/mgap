nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"

    test("Run pipeline with test data - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"

        when {
            params {
                input           = "${projectDir}/assets/samplesheet_test.csv"
                seq_type        = "illumina"
                run_kraken2     = false
                adjust_coverage = false
                outdir          = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            assertAll(
                { assert workflow.success },
                { assert succeeded.any { it.contains('FASTP') } },
                { assert succeeded.any { it.contains('SPADES') } },
                { assert succeeded.any { it.contains('QUAST') } },
                { assert succeeded.any { it.contains('MLST') } },
                { assert succeeded.any { it.contains('MGAP_REPORT') } },
                { assert path("$outputDir/report/mgap_report.html").exists() },
                { assert path("$outputDir/report/mgap_summary.tsv").exists() },
                { assert path("$outputDir/report/mgap_summary.xlsx").exists() },
                // the published versions include the report's own
                { assert path("$outputDir/pipeline_info/software_versions.yml").yaml.keySet().any { it.endsWith('MGAP_REPORT') } }
            )
        }

    }

    test("Run report skipped with --skip_report - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"

        when {
            params {
                input           = "${projectDir}/assets/samplesheet_test.csv"
                seq_type        = "illumina"
                run_kraken2     = false
                adjust_coverage = false
                skip_report     = true
                outdir          = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            assertAll(
                { assert workflow.success },
                { assert !succeeded.any { it.contains('MGAP_REPORT') } },
                { assert !path("$outputDir/report").exists() },
                { assert path("$outputDir/pipeline_info/software_versions.yml").exists() }
            )
        }

    }

    test("Run report with a numeric sample name - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"

        when {
            params {
                input    = "${projectDir}/tests/data/samplesheet_numeric_name.csv"
                seq_type = "contig"
                outdir   = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            assertAll(
                { assert workflow.success },
                { assert succeeded.any { it.contains('MGAP_REPORT') } },
                { assert path("$outputDir/report/mgap_report.html").exists() }
            )
        }

    }

    test("Run pipeline with coverage adjustment - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"
        // fastp stub reports 1 Gb, the MASH_SKETCH stub a 5 Mb genome: 200x
        config "./config/fastp_stub_stats.config"

        when {
            params {
                input           = "${projectDir}/assets/samplesheet_test.csv"
                seq_type        = "illumina"
                run_kraken2     = false
                adjust_coverage = true
                outdir          = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            assertAll(
                { assert workflow.success },
                { assert succeeded.any { it.contains('MASH_SKETCH') } },
                { assert succeeded.any { it.contains('SEQTK_SAMPLE') } },
                { assert succeeded.any { it.contains('SPADES') } }
            )
        }

    }

    test("Run pipeline with Kraken2 and Bracken - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"
        // fastp stub: 151 cycles; stub database: 100, 150 and 300 bp kmer distributions
        config "./config/bracken_read_length.config"

        when {
            params {
                input           = "${projectDir}/assets/samplesheet_test.csv"
                seq_type        = "illumina"
                run_kraken2     = true
                kraken2db       = "${projectDir}/tests/data/stub_db/kraken2"
                adjust_coverage = false
                outdir          = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            def kraken2 = TaskArgs.of(metaDir, 'KRAKEN2')
            assertAll(
                { assert workflow.success },
                { assert succeeded.any { it.contains('KRAKEN2') } },
                { assert succeeded.any { it.contains('BRACKEN') } },
                { assert succeeded.any { it.contains('SPADES') } },
                { assert kraken2.size() == 1 },
                { assert kraken2.values().every { it == '--memory-mapping' } },
                // the longest database read length at or below the 151 sequenced cycles
                { assert TaskArgs.of(metaDir, 'BRACKEN') == [ TEST_BFRAGILIS: '-r 150' ] }
            )
        }

    }

    test("Bracken read length set with --bracken_read_length - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"
        config "./config/bracken_read_length.config"

        when {
            params {
                input               = "${projectDir}/assets/samplesheet_test.csv"
                seq_type            = "illumina"
                kraken2db           = "${projectDir}/tests/data/stub_db/kraken2"
                bracken_read_length = 300
                adjust_coverage     = false
                outdir              = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert TaskArgs.of(metaDir, 'BRACKEN') == [ TEST_BFRAGILIS: '-r 300' ] }
            )
        }

    }

    test("Bracken read length when no database read length fits the reads - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"
        config "./config/bracken_read_length.config"

        when {
            params {
                input            = "${projectDir}/assets/samplesheet_test.csv"
                seq_type         = "illumina"
                kraken2db        = "${projectDir}/tests/data/stub_db/kraken2"
                // 75 bp reads, shorter than the database's 100, 150 and 300
                stub_read_cycles = 75
                adjust_coverage  = false
                outdir           = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert TaskArgs.of(metaDir, 'BRACKEN') == [ TEST_BFRAGILIS: '-r 100' ] },
                { assert path("$metaDir/nextflow.log").text.contains("Sample 'TEST_BFRAGILIS': reads are 75 bp, shorter than every Bracken database read length (100, 150, 300) - Bracken uses -r 100.") }
            )
        }

    }

    test("Bracken read length not in the database fails at launch - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"

        when {
            params {
                input               = "${projectDir}/assets/samplesheet_test.csv"
                seq_type            = "illumina"
                kraken2db           = "${projectDir}/tests/data/stub_db/kraken2"
                bracken_read_length = 250
                outdir              = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert path("$metaDir/nextflow.log").text.contains("--bracken_read_length 250: the Bracken database") }
            )
        }

    }

    test("Run pipeline with single-end Illumina data - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"

        when {
            params {
                input           = "${projectDir}/assets/samplesheet_test_se.csv"
                seq_type        = "illumina"
                run_kraken2     = false
                adjust_coverage = false
                outdir          = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            assertAll(
                { assert workflow.success },
                { assert succeeded.any { it.contains('FASTP') } },
                { assert succeeded.any { it.contains('SPADES') } }
            )
        }

    }

    test("Run pipeline with ONT data - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"

        when {
            params {
                input           = "${projectDir}/assets/samplesheet_test_ont.csv"
                seq_type        = "ont"
                run_kraken2     = false
                adjust_coverage = false
                outdir          = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            assertAll(
                { assert workflow.success },
                { assert succeeded.any { it.contains('FASTPLONG') } },
                { assert succeeded.any { it.contains('FLYE') } },
                { assert succeeded.any { it.contains('MEDAKA') } },
                { assert succeeded.any { it.contains('DNAAPLER') } },
                { assert succeeded.any { it.contains('MLST') } },
                // nf-core flye gzips the assembly and graph; both are published
                { assert path("$outputDir/TEST_BFRAGILIS_ONT/assemblies/flye/TEST_BFRAGILIS_ONT.assembly.fasta.gz").exists() },
                { assert path("$outputDir/TEST_BFRAGILIS_ONT/assemblies/flye/TEST_BFRAGILIS_ONT.assembly_graph.gfa.gz").exists() }
            )
        }

    }

    test("ONT reads are not subsampled - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"
        config "./config/ext_args.config"

        when {
            params {
                input       = "${projectDir}/assets/samplesheet_test_ont.csv"
                seq_type    = "ont"
                run_kraken2 = false
                // default true: applies to Illumina only
                adjust_coverage = true
                max_coverage    = 100
                outdir      = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            def flye = TaskArgs.of(metaDir, 'FLYE')
            assertAll(
                { assert workflow.success },
                { assert path("$metaDir/nextflow.log").text.contains("--max_coverage applies only to --seq_type illumina") },
                { assert !succeeded.any { it.contains('MASH_SKETCH') } },
                { assert !succeeded.any { it.contains('SEQTK_SAMPLE') } },
                { assert !succeeded.any { it.contains('LRGE') } },
                { assert flye == [ TEST_BFRAGILIS_ONT: '' ] },
                { assert succeeded.any { it.contains('MEDAKA') } }
            )
        }

    }

    test("Flye --asm-coverage with --genome_size - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"
        config "./config/ext_args.config"

        when {
            params {
                input             = "${projectDir}/assets/samplesheet_test_ont.csv"
                seq_type          = "ont"
                run_kraken2       = false
                flye_asm_coverage = 40
                genome_size       = "5.5m"
                outdir            = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            assertAll(
                { assert workflow.success },
                { assert !succeeded.any { it.contains('LRGE') } },
                { assert TaskArgs.of(metaDir, 'FLYE') == [ TEST_BFRAGILIS_ONT: '--asm-coverage 40 --genome-size 5.5m' ] },
                // the assembly still joins the reads for Medaka after FLYE's extra meta key
                { assert succeeded.any { it.contains('MEDAKA') } },
                { assert succeeded.any { it.contains('MLST') } }
            )
        }

    }

    test("Flye --asm-coverage with the lrge genome size - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"
        config "./config/ext_args.config"

        when {
            params {
                input             = "${projectDir}/assets/samplesheet_test_ont.csv"
                seq_type          = "ont"
                run_kraken2       = false
                flye_asm_coverage = 40
                outdir            = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            assertAll(
                { assert workflow.success },
                { assert TaskArgs.of(metaDir, 'LRGE') == [ TEST_BFRAGILIS_ONT: '--seed 11' ] },
                // the LRGE stub estimates 5000000
                { assert TaskArgs.of(metaDir, 'FLYE') == [ TEST_BFRAGILIS_ONT: '--asm-coverage 40 --genome-size 5000000' ] },
                { assert succeeded.any { it.contains('MEDAKA') } },
                { assert path("$outputDir/TEST_BFRAGILIS_ONT/assemblies/lrge/TEST_BFRAGILIS_ONT.genome_size.txt").exists() }
            )
        }

    }

    test("Run pipeline with ONT data (autocycler) - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"

        when {
            params {
                input           = "${projectDir}/assets/samplesheet_test_ont.csv"
                seq_type        = "ont"
                ont_assembler   = "autocycler"
                run_kraken2     = false
                adjust_coverage = false
                outdir          = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            assertAll(
                { assert workflow.success },
                { assert succeeded.any { it.contains('AUTOCYCLER_ASSEMBLY') } },
                { assert succeeded.any { it.contains('AUTOCYCLER_CONSENSUS') } },
                { assert succeeded.any { it.contains('AUTOCYCLER_GFA2FASTA') } },
                { assert succeeded.any { it.contains('MLST') } }
            )
        }

    }

    test("Run pipeline with ONT data (autocycler), one sample without a consensus - stub") {

        tag "pipeline"
        tag "stub"
        tag "autocycler"

        options "-stub"
        config "./config/autocycler_no_consensus.config"

        when {
            params {
                input           = "${projectDir}/tests/data/samplesheet_ont_no_consensus.csv"
                seq_type        = "ont"
                ont_assembler   = "autocycler"
                run_kraken2     = false
                adjust_coverage = false
                outdir          = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            // log.warn reaches only the log file, not the console nf-test captures
            def nextflow_log = path("${metaDir}/nextflow.log").text
            assertAll(
                { assert workflow.success },
                { assert succeeded.count { it.startsWith('GENE2DIS_MGAP:MGAP:ONT:AUTOCYCLER_CONSENSUS') } == 2 },
                { assert nextflow_log.contains("Sample 'TEST_NO_CONSENSUS': no Autocycler cluster passed QC") },
                { assert !nextflow_log.contains("Sample 'TEST_CONSENSUS': no Autocycler cluster passed QC") },
                { assert succeeded.any { it.contains('MLST (TEST_CONSENSUS)') } },
                { assert !succeeded.any { it.contains('MLST (TEST_NO_CONSENSUS)') } },
                { assert !succeeded.any { it.contains('DNAAPLER (TEST_NO_CONSENSUS)') } }
            )
        }

    }

    test("Run pipeline with contig data - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"

        when {
            params {
                input    = "${projectDir}/assets/samplesheet_test_contig.csv"
