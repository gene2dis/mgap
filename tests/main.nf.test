                { assert annotation.tools == ['CHECKM2', 'MLST', 'GTDBTK', 'GENOMAD', 'MOBSUITE_RECON', 'RGI_MAIN', 'BAKTA', 'KLEBORATE', 'SCCMEC', 'SISTR'] as Set },
