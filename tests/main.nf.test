nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"

    test("Run pipeline with test data - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"

        when {
            params {
                input           = "${projectDir}/assets/samplesheet_test.csv"
                seq_type        = "illumina"
                run_kraken2     = false
                adjust_coverage = false
                outdir          = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            assertAll(
                { assert workflow.success },
                { assert succeeded.any { it.contains('FASTP') } },
                { assert succeeded.any { it.contains('SPADES') } },
                { assert succeeded.any { it.contains('QUAST') } },
                { assert succeeded.any { it.contains('MLST') } }
            )
        }

    }

    test("Run pipeline with single-end Illumina data - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"

        when {
            params {
                input           = "${projectDir}/assets/samplesheet_test_se.csv"
                seq_type        = "illumina"
                run_kraken2     = false
                adjust_coverage = false
                outdir          = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            assertAll(
                { assert workflow.success },
                { assert succeeded.any { it.contains('FASTP') } },
                { assert succeeded.any { it.contains('SPADES') } }
            )
        }

    }

    test("Run pipeline with ONT data - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"

        when {
            params {
                input           = "${projectDir}/assets/samplesheet_test_ont.csv"
                seq_type        = "ont"
                run_kraken2     = false
                adjust_coverage = false
                outdir          = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            assertAll(
                { assert workflow.success },
                { assert succeeded.any { it.contains('FASTPLONG') } },
                { assert succeeded.any { it.contains('FLYE') } },
                { assert succeeded.any { it.contains('MEDAKA') } },
                { assert succeeded.any { it.contains('DNAAPLER') } },
                { assert succeeded.any { it.contains('MLST') } }
            )
        }

    }

    test("Run pipeline with ONT data (autocycler) - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"

        when {
            params {
                input           = "${projectDir}/assets/samplesheet_test_ont.csv"
                seq_type        = "ont"
                ont_assembler   = "autocycler"
                run_kraken2     = false
                adjust_coverage = false
                outdir          = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            assertAll(
                { assert workflow.success },
                { assert succeeded.any { it.contains('AUTOCYCLER_ASSEMBLY') } },
                { assert succeeded.any { it.contains('AUTOCYCLER_COMBINE') } },
                { assert succeeded.any { it.contains('AUTOCYCLER_GFA2FASTA') } },
                { assert succeeded.any { it.contains('MLST') } }
            )
        }

    }

    test("Run pipeline with contig data - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"

        when {
            params {
                input    = "${projectDir}/assets/samplesheet_test_contig.csv"
                seq_type = "contig"
                outdir   = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            assertAll(
                { assert workflow.success },
                { assert succeeded.any { it.contains('QUAST') } },
                { assert succeeded.any { it.contains('MLST') } }
            )
        }

    }

    test("Run pipeline with test data") {

        tag "pipeline"
        tag "slow"

        when {
            params {
                input           = "${projectDir}/assets/samplesheet_test.csv"
                seq_type        = "illumina"
                run_kraken2     = false
                adjust_coverage = false
                outdir          = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            def versions = path("$outputDir/pipeline_info/software_versions.yml").yaml
            def sample = "TEST_BFRAGILIS"
            assertAll(
                { assert workflow.success },
                { assert succeeded.any { it.contains('FASTP') } },
                { assert succeeded.any { it.contains('SPADES') } },
                { assert succeeded.any { it.contains('QUAST') } },
                { assert succeeded.any { it.contains('MLST') } },
                { assert succeeded.any { it.contains('MULTIQC') } },
                { assert versions instanceof Map },
                { assert versions.keySet().any { it.contains('MLST') } },
                { assert versions.containsKey('Workflow') },
                // published outputs exist and the QUAST report has content
                { assert path("$outputDir/${sample}/read_processing/fastp/${sample}.fastp.json").exists() },
                { assert path("$outputDir/${sample}/qc/quast/${sample}.tsv").text.readLines().size() > 1 },
                { assert path("$outputDir/${sample}/annotation/mlst/${sample}.tsv").exists() },
                { assert path("$outputDir/multiqc/multiqc_report.html").exists() }
            )
        }

    }

}
