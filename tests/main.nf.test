    }

    test("Duplicate sample names fail at launch - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"

        when {
            params {
                input    = "${projectDir}/tests/data/samplesheet_duplicate_sample.csv"
                seq_type = "illumina"
                outdir   = "$outputDir"
            }
        }

        then {
            def output = (workflow.stdout + workflow.stderr).join('\n')
            assertAll(
                { assert workflow.failed },
                { assert workflow.trace.tasks().size() == 0 },
                { assert output.contains('Detected duplicate entries: [sample:TEST_BFRAGILIS]') }
            )
        }

    }

    test("Zero --genome_size fails at launch - stub") {

        tag "pipeline"
        tag "stub"

        // On the command line: "0" there is not caught by the schema pattern
        options "-stub --genome_size 0"

        when {
            params {
                input             = "${projectDir}/assets/samplesheet_test_ont.csv"
                seq_type          = "ont"
                run_kraken2       = false
                flye_asm_coverage = 40
                outdir            = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.trace.tasks().size() == 0 },
                { assert path("$metaDir/nextflow.log").text.contains("--genome_size 0: the genome size must be greater than zero.") }
            )
        }

    }

    test("Default-true flags switched off on the command line - stub") {

        tag "pipeline"
        tag "stub"

        // On the command line, not in params {}: nf-test writes params {} to a
        // params file, which keeps them typed; the command line passes the
        // string "false", which is truthy unless read as a boolean
        options "-stub --adjust_coverage false --run_kraken2 false --run_dnaapler false"

        when {
            params {
                input     = "${projectDir}/assets/samplesheet_test_ont.csv"
                seq_type  = "ont"
                kraken2db = "${projectDir}/tests/data/stub_db/kraken2"
                outdir    = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            assertAll(
                { assert workflow.success },
                { assert succeeded.any { it.contains('FLYE') } },
                { assert !succeeded.any { it.contains('KRAKEN2') } },
                { assert !succeeded.any { it.contains('DNAAPLER') } },
                { assert !succeeded.any { it.contains('MASH_SKETCH') } }
            )
        }

    }

    test("Default-true flag switched off on the command line, Illumina - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub --adjust_coverage false --run_kraken2 false"

        when {
            params {
                input     = "${projectDir}/assets/samplesheet_test.csv"
                seq_type  = "illumina"
                kraken2db = "${projectDir}/tests/data/stub_db/kraken2"
                outdir    = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            assertAll(
                { assert workflow.success },
                { assert succeeded.any { it.contains('SPADES') } },
                { assert !succeeded.any { it.contains('KRAKEN2') } },
                { assert !succeeded.any { it.contains('BRACKEN') } },
                { assert !succeeded.any { it.contains('MASH_SKETCH') } }
            )
        }

    }

    test("Run pipeline with test data") {

        tag "pipeline"
        tag "slow"

        when {
            params {
                input           = "${projectDir}/assets/samplesheet_test.csv"
                seq_type        = "illumina"
                run_kraken2     = false
                adjust_coverage = false
                // ~11 Mb after fastp, below the 50 Mb default (as in conf/test.config)
                min_bases       = 5000000
                outdir          = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            def versions = path("$outputDir/pipeline_info/software_versions.yml").yaml
            def report = path("$outputDir/report/mgap_report.html").text
            def sample = "TEST_BFRAGILIS"
            assertAll(
                { assert workflow.success },
                { assert succeeded.any { it.contains('FASTP') } },
                { assert succeeded.any { it.contains('SPADES') } },
                { assert succeeded.any { it.contains('QUAST') } },
                { assert succeeded.any { it.contains('MLST') } },
                { assert succeeded.any { it.contains('MULTIQC') } },
                { assert versions instanceof Map },
                { assert versions.keySet().any { it.contains('MLST') } },
                { assert versions.find { it.key.contains('MULTIQC') }?.value?.multiqc },
                { assert versions.containsKey('Workflow') },
                // published outputs exist and the QUAST report has content
                { assert path("$outputDir/${sample}/read_processing/fastp/${sample}.fastp.json").exists() },
                { assert path("$outputDir/${sample}/qc/quast/${sample}.tsv").text.readLines().size() > 1 },
                { assert path("$outputDir/${sample}/annotation/mlst/${sample}.tsv").exists() },
                { assert path("$outputDir/multiqc/multiqc_report.html").exists() },
                // MultiQC parsed the QUAST report, under the sample ID
                { assert path("$outputDir/multiqc/multiqc_data/multiqc_quast.txt").readLines()*.split('\t')*.getAt(0) == [ 'Sample', sample ] },
                // run report without databases: read QC, assembly and MLST sections, none of the database ones
                { assert succeeded.any { it.contains('MGAP_REPORT') } },
                { assert [ 'overview', 'read-qc', 'assembly', 'typing', 'samples', 'methods' ].every { report.contains("<section id=\"${it}\"") } },
                { assert [ 'quality', 'amr', 'mobile' ].every { !report.contains("<section id=\"${it}\"") } },
                { assert path("$outputDir/report/mgap_summary.tsv").readLines()*.split('\t')*.getAt(0) == [ 'sample', sample ] },
                { assert path("$outputDir/report/mgap_summary.xlsx").exists() }
            )
        }

    }

}
