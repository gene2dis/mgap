    test("Plasmid consensus, ONT with Flye - stub") {

        tag "pipeline"
        tag "stub"
        tag "plasmids"

        options "-stub"
        config "./config/plasmids.config"

        when {
            params {
                input        = "${projectDir}/assets/samplesheet_test_ont.csv"
                seq_type     = "ont"
                run_kraken2  = false
                genomad_db   = "${projectDir}/tests/data/stub_db/genomad"
                run_mobsuite = true
                outdir       = "$outputDir"
            }
        }

        then {
            def sample = 'TEST_BFRAGILIS_ONT'
            // read as text: the stubs run in the seqkit image (annotation_input.config), so some version lines are not YAML
            def versions = path("$outputDir/pipeline_info/software_versions.yml").text
            assertAll(
                { assert workflow.success },
                // circular contigs from Flye's assembly_info.txt, each typed on its own
                { assert TaskArgs.of(metaDir, 'PLASMID_CIRCULAR') == [ (sample): '' ] },
                { assert TaskArgs.of(metaDir, 'MOBSUITE_TYPER') == [ (sample): '--multi' ] },
                // the stub mob_recon finds no plasmid, so there is no mobtyper_results.txt
                { assert TaskArgs.inputFolders(metaDir, 'PLASMID_CONSENSUS') == [ (sample): [ 'fasta', 'flye', 'genomad', 'mob_recon', 'mob_typer', 'plasmidfinder' ] ] },
                { assert path("$outputDir/${sample}/annotation/plasmid_consensus/${sample}.plasmid_consensus.tsv").exists() },
                { assert path("$outputDir/${sample}/annotation/mobsuite/${sample}_circular_mobtyper.txt").exists() },
                { assert path("$outputDir/${sample}/annotation/plasmidfinder/${sample}.tsv").exists() },
                { assert [ 'PLASMIDFINDER', 'PLASMID_CIRCULAR', 'MOBSUITE_TYPER', 'PLASMID_CONSENSUS' ].every { tool -> versions.contains(":${tool}\":") } }
            )
        }

    }

