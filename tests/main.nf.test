nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"

    test("Run pipeline with test data - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"

        when {
            params {
                input           = "${projectDir}/assets/samplesheet_test.csv"
                seq_type        = "illumina"
                run_kraken2     = false
                adjust_coverage = false
                outdir          = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            assertAll(
                { assert workflow.success },
                { assert succeeded.any { it.contains('FASTP') } },
                { assert succeeded.any { it.contains('SPADES') } },
                { assert succeeded.any { it.contains('QUAST') } },
                { assert succeeded.any { it.contains('MLST') } },
                { assert succeeded.any { it.contains('MGAP_REPORT') } },
                // ISEScan is off by default (D-9)
                { assert !succeeded.any { it.contains('ISESCAN') } },
                { assert path("$outputDir/report/mgap_report.html").exists() },
                { assert path("$outputDir/report/mgap_summary.tsv").exists() },
                { assert path("$outputDir/report/mgap_summary.xlsx").exists() },
                // the published versions include the report's own
                { assert path("$outputDir/pipeline_info/software_versions.yml").yaml.keySet().any { it.endsWith('MGAP_REPORT') } }
            )
        }

    }

    test("Run report skipped with --skip_report - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"

        when {
            params {
                input           = "${projectDir}/assets/samplesheet_test.csv"
                seq_type        = "illumina"
                run_kraken2     = false
                adjust_coverage = false
                skip_report     = true
                outdir          = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            assertAll(
                { assert workflow.success },
                { assert !succeeded.any { it.contains('MGAP_REPORT') } },
                { assert !path("$outputDir/report").exists() },
                { assert path("$outputDir/pipeline_info/software_versions.yml").exists() }
            )
        }

    }

    test("Run report with a numeric sample name - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"

        when {
            params {
                input    = "${projectDir}/tests/data/samplesheet_numeric_name.csv"
                seq_type = "contig"
                outdir   = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            assertAll(
                { assert workflow.success },
                { assert succeeded.any { it.contains('MGAP_REPORT') } },
                { assert path("$outputDir/report/mgap_report.html").exists() }
            )
        }

    }

    test("Run pipeline with coverage adjustment - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"
        // fastp stub reports 1 Gb, the MASH_SKETCH stub a 5 Mb genome: 200x
        config "./config/fastp_stub_stats.config"

        when {
            params {
                input           = "${projectDir}/assets/samplesheet_test.csv"
                seq_type        = "illumina"
                run_kraken2     = false
                adjust_coverage = true
                outdir          = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            assertAll(
                { assert workflow.success },
                { assert succeeded.any { it.contains('MASH_SKETCH') } },
                { assert succeeded.any { it.contains('SEQTK_SAMPLE') } },
                { assert succeeded.any { it.contains('SPADES') } }
            )
        }

    }

    test("Run pipeline with Kraken2 and Bracken - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"
        // fastp stub: 151 cycles; stub database: 100, 150 and 300 bp kmer distributions
        config "./config/bracken_read_length.config"

        when {
            params {
                input           = "${projectDir}/assets/samplesheet_test.csv"
                seq_type        = "illumina"
                run_kraken2     = true
                kraken2db       = "${projectDir}/tests/data/stub_db/kraken2"
                adjust_coverage = false
                outdir          = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            def kraken2 = TaskArgs.of(metaDir, 'KRAKEN2')
            assertAll(
                { assert workflow.success },
                { assert succeeded.any { it.contains('KRAKEN2') } },
                { assert succeeded.any { it.contains('BRACKEN') } },
                { assert succeeded.any { it.contains('SPADES') } },
                { assert kraken2.size() == 1 },
                { assert kraken2.values().every { it == '--memory-mapping' } },
                // the longest database read length at or below the 151 sequenced cycles
                { assert TaskArgs.of(metaDir, 'BRACKEN') == [ TEST_BFRAGILIS: '-r 150' ] }
            )
        }

    }

    test("Bracken read length set with --bracken_read_length - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"
        config "./config/bracken_read_length.config"

        when {
            params {
                input               = "${projectDir}/assets/samplesheet_test.csv"
                seq_type            = "illumina"
                kraken2db           = "${projectDir}/tests/data/stub_db/kraken2"
                bracken_read_length = 300
                adjust_coverage     = false
                outdir              = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert TaskArgs.of(metaDir, 'BRACKEN') == [ TEST_BFRAGILIS: '-r 300' ] }
            )
        }

    }

    test("Bracken read length when no database read length fits the reads - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"
        config "./config/bracken_read_length.config"

        when {
            params {
                input            = "${projectDir}/assets/samplesheet_test.csv"
                seq_type         = "illumina"
                kraken2db        = "${projectDir}/tests/data/stub_db/kraken2"
                // 75 bp reads, shorter than the database's 100, 150 and 300
                stub_read_cycles = 75
                adjust_coverage  = false
                outdir           = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert TaskArgs.of(metaDir, 'BRACKEN') == [ TEST_BFRAGILIS: '-r 100' ] },
                { assert path("$metaDir/nextflow.log").text.contains("Sample 'TEST_BFRAGILIS': reads are 75 bp, shorter than every Bracken database read length (100, 150, 300) - Bracken uses -r 100.") }
            )
        }

    }

    test("Bracken read length not in the database fails at launch - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"

        when {
            params {
                input               = "${projectDir}/assets/samplesheet_test.csv"
                seq_type            = "illumina"
                kraken2db           = "${projectDir}/tests/data/stub_db/kraken2"
                bracken_read_length = 250
                outdir              = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert path("$metaDir/nextflow.log").text.contains("--bracken_read_length 250: the Bracken database") }
            )
        }

    }

    test("Run pipeline with single-end Illumina data - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"

        when {
            params {
                input           = "${projectDir}/assets/samplesheet_test_se.csv"
                seq_type        = "illumina"
                run_kraken2     = false
                adjust_coverage = false
                outdir          = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            assertAll(
                { assert workflow.success },
                { assert succeeded.any { it.contains('FASTP') } },
                { assert succeeded.any { it.contains('SPADES') } }
            )
        }

    }

    test("Run pipeline with ONT data - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"

        when {
            params {
                input           = "${projectDir}/assets/samplesheet_test_ont.csv"
                seq_type        = "ont"
                run_kraken2     = false
                adjust_coverage = false
                outdir          = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            assertAll(
                { assert workflow.success },
                { assert succeeded.any { it.contains('FASTPLONG') } },
                { assert succeeded.any { it.contains('FLYE') } },
                { assert succeeded.any { it.contains('BEROKKA') } },
                { assert succeeded.any { it.contains('MEDAKA') } },
                { assert succeeded.any { it.contains('DNAAPLER') } },
                { assert succeeded.any { it.contains('MLST') } },
                { assert path("$outputDir/TEST_BFRAGILIS_ONT/assemblies/berokka/TEST_BFRAGILIS_ONT.berokka.tsv").exists() },
                // nf-core flye gzips the assembly and graph; both are published
                { assert path("$outputDir/TEST_BFRAGILIS_ONT/assemblies/flye/TEST_BFRAGILIS_ONT.assembly.fasta.gz").exists() },
                { assert path("$outputDir/TEST_BFRAGILIS_ONT/assemblies/flye/TEST_BFRAGILIS_ONT.assembly_graph.gfa.gz").exists() }
            )
        }

    }

    test("ONT reads are not subsampled - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"
        config "./config/ext_args.config"

        when {
            params {
                input       = "${projectDir}/assets/samplesheet_test_ont.csv"
                seq_type    = "ont"
                run_kraken2 = false
                // default true: applies to Illumina only
                adjust_coverage = true
                max_coverage    = 100
                outdir      = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            def flye = TaskArgs.of(metaDir, 'FLYE')
            assertAll(
                { assert workflow.success },
                { assert path("$metaDir/nextflow.log").text.contains("--max_coverage applies only to --seq_type illumina") },
                { assert !succeeded.any { it.contains('MASH_SKETCH') } },
                { assert !succeeded.any { it.contains('SEQTK_SAMPLE') } },
                { assert !succeeded.any { it.contains('LRGE') } },
                { assert flye == [ TEST_BFRAGILIS_ONT: '' ] },
                { assert succeeded.any { it.contains('MEDAKA') } },
                // no -m: Medaka takes the model named in the reads
                { assert TaskArgs.of(metaDir, 'MEDAKA') == [ TEST_BFRAGILIS_ONT: '' ] }
            )
        }

    }

    test("Medaka bacterial model with --medaka_bacteria - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"
        config "./config/ext_args.config"

        when {
            params {
                input           = "${projectDir}/assets/samplesheet_test_ont.csv"
                seq_type        = "ont"
                run_kraken2     = false
                medaka_bacteria = true
                outdir          = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert TaskArgs.of(metaDir, 'MEDAKA') == [ TEST_BFRAGILIS_ONT: '--bacteria' ] },
                { assert !path("$metaDir/nextflow.log").text.contains("--medaka_bacteria is ignored") }
            )
        }

    }

    test("Medaka model set together with --medaka_bacteria - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"
        config "./config/ext_args.config"

        when {
            params {
                input           = "${projectDir}/assets/samplesheet_test_ont.csv"
                seq_type        = "ont"
                run_kraken2     = false
                medaka_model    = "r1041_e82_400bps_sup_v4.1.0"
                medaka_bacteria = true
                outdir          = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert TaskArgs.of(metaDir, 'MEDAKA') == [ TEST_BFRAGILIS_ONT: '-m r1041_e82_400bps_sup_v4.1.0' ] },
                { assert path("$metaDir/nextflow.log").text.contains("--medaka_bacteria is ignored when --medaka_model is set: Medaka polishes with r1041_e82_400bps_sup_v4.1.0.") }
            )
        }

    }

    test("Medaka options outside ONT Flye mode are reported as ignored - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"

        when {
            params {
                input           = "${projectDir}/assets/samplesheet_test_contig.csv"
                seq_type        = "contig"
                medaka_bacteria = true
                outdir          = "$outputDir"
            }
        }

        then {
            def log = path("$metaDir/nextflow.log").text
            assertAll(
                { assert workflow.success },
                { assert !workflow.trace.tasks().any { it.name.contains('MEDAKA') } },
                { assert log.contains("--medaka_model and --medaka_bacteria apply only to --seq_type ont with --ont_assembler flye: ignored.") },
                { assert !log.contains("--medaka_bacteria is ignored when --medaka_model is set") }
            )
        }

    }

    test("Flye --asm-coverage with --genome_size - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"
        config "./config/ext_args.config"

        when {
            params {
                input             = "${projectDir}/assets/samplesheet_test_ont.csv"
                seq_type          = "ont"
                run_kraken2       = false
                flye_asm_coverage = 40
                genome_size       = "5.5m"
                outdir            = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            assertAll(
                { assert workflow.success },
                { assert !succeeded.any { it.contains('LRGE') } },
                { assert TaskArgs.of(metaDir, 'FLYE') == [ TEST_BFRAGILIS_ONT: '--asm-coverage 40 --genome-size 5.5m' ] },
                // the assembly still joins the reads for Medaka after FLYE's extra meta key
                { assert succeeded.any { it.contains('MEDAKA') } },
                { assert succeeded.any { it.contains('MLST') } }
            )
        }

    }

    test("Flye --asm-coverage with the lrge genome size - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"
        config "./config/ext_args.config"

        when {
            params {
                input             = "${projectDir}/assets/samplesheet_test_ont.csv"
                seq_type          = "ont"
                run_kraken2       = false
                flye_asm_coverage = 40
                outdir            = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            assertAll(
                { assert workflow.success },
                { assert TaskArgs.of(metaDir, 'LRGE') == [ TEST_BFRAGILIS_ONT: '--seed 11' ] },
                // the LRGE stub estimates 5000000
                { assert TaskArgs.of(metaDir, 'FLYE') == [ TEST_BFRAGILIS_ONT: '--asm-coverage 40 --genome-size 5000000' ] },
                { assert succeeded.any { it.contains('MEDAKA') } },
                { assert path("$outputDir/TEST_BFRAGILIS_ONT/assemblies/lrge/TEST_BFRAGILIS_ONT.genome_size.txt").exists() }
            )
        }

    }

    test("Run pipeline with ONT data (autocycler) - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"

        when {
            params {
                input           = "${projectDir}/assets/samplesheet_test_ont.csv"
                seq_type        = "ont"
                ont_assembler   = "autocycler"
                run_kraken2     = false
                adjust_coverage = false
                outdir          = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            assertAll(
                { assert workflow.success },
                { assert succeeded.any { it.contains('AUTOCYCLER_ASSEMBLY') } },
                { assert succeeded.any { it.contains('AUTOCYCLER_CONSENSUS') } },
                { assert succeeded.any { it.contains('AUTOCYCLER_GFA2FASTA') } },
                { assert succeeded.any { it.contains('MLST') } },
                // Autocycler's trim step removes end overlaps itself
                { assert !succeeded.any { it.contains('BEROKKA') } }
            )
        }

    }

    test("Run pipeline with ONT data (autocycler), one sample without a consensus - stub") {

        tag "pipeline"
        tag "stub"
        tag "autocycler"

        options "-stub"
        config "./config/autocycler_no_consensus.config"

        when {
            params {
                input           = "${projectDir}/tests/data/samplesheet_ont_no_consensus.csv"
                seq_type        = "ont"
                ont_assembler   = "autocycler"
                run_kraken2     = false
                adjust_coverage = false
                outdir          = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            // log.warn reaches only the log file, not the console nf-test captures
            def nextflow_log = path("${metaDir}/nextflow.log").text
            assertAll(
                { assert workflow.success },
                { assert succeeded.count { it.startsWith('GENE2DIS_MGAP:MGAP:ONT:AUTOCYCLER_CONSENSUS') } == 2 },
                { assert nextflow_log.contains("Sample 'TEST_NO_CONSENSUS': no Autocycler cluster passed QC") },
                { assert !nextflow_log.contains("Sample 'TEST_CONSENSUS': no Autocycler cluster passed QC") },
                { assert succeeded.any { it.contains('MLST (TEST_CONSENSUS)') } },
                { assert !succeeded.any { it.contains('MLST (TEST_NO_CONSENSUS)') } },
                { assert !succeeded.any { it.contains('DNAAPLER (TEST_NO_CONSENSUS)') } }
            )
        }

    }

    test("Run pipeline with contig data - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"

        when {
            params {
                input    = "${projectDir}/assets/samplesheet_test_contig.csv"
                seq_type = "contig"
                outdir   = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            assertAll(
                { assert workflow.success },
                { assert succeeded.any { it.contains('QUAST') } },
                { assert succeeded.any { it.contains('MLST') } },
                // MultiQC's version reaches software_versions.yml
                { assert path("$outputDir/pipeline_info/software_versions.yml").yaml.keySet().any { it.contains('MULTIQC') } }
            )
        }

    }

    test("ISEScan with --run_isescan, published and read by the report - stub") {

        tag "pipeline"
        tag "stub"
        tag "isescan"

        options "-stub"

        when {
            params {
                input       = "${projectDir}/assets/samplesheet_test_contig.csv"
                seq_type    = "contig"
                run_isescan = true
                outdir      = "$outputDir"
            }
        }

        then {
            def sample = 'TEST_BFRAGILIS_CONTIG'
            def table = path("$outputDir/${sample}/annotation/isescan/${sample}.isescan.tsv")
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.succeeded().any { it.name.contains("ISESCAN (${sample})") } },
                // the stub writes the header-only table of a sample without IS elements
                { assert table.readLines() == [ table.readLines()[0] ] },
                { assert table.readLines()[0].tokenize('\t')[0..2] == [ 'seqID', 'family', 'cluster' ] },
                { assert "${sample}.isescan.tsv".toString() in TaskArgs.stagedNames(metaDir, 'MGAP_REPORT') },
                { assert path("$outputDir/pipeline_info/software_versions.yml").yaml.keySet().any { it.endsWith('ISESCAN') } }
            )
        }

    }

    test("MLST scheme routes samples to species tools - stub") {

        tag "pipeline"
        tag "stub"

        options "-stub"
        config "./config/species_routing.config"

        when {
            params {
                input        = "${projectDir}/tests/data/samplesheet_species_routing.csv"
                seq_type     = "contig"
                bakta_db     = "${projectDir}/tests/data/stub_db/bakta"
                amrfinder_db = "${projectDir}/tests/data/stub_db/amrfinderplus"
                outdir       = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            def ran = { process, sample -> succeeded.any { it.contains(process) && it.contains("(${sample})") } }
            // log.warn reaches only the log file, not the console nf-test captures
            def nextflow_log = path("${metaDir}/nextflow.log").text
            def amrfinder = { sample -> path("$outputDir/${sample}/annotation/amrfinder/${sample}-mutations.tsv") }
            assertAll(
                { assert workflow.success },
                // klebsiella scheme -> Kleborate only
                { assert ran('KLEBORATE', 'TEST_KPNEUMONIAE') },
                { assert !ran('KLEBORATE', 'TEST_SAUREUS') },
                { assert !ran('KLEBORATE', 'TEST_SENTERICA') },
                { assert !ran('KLEBORATE', 'TEST_OTHER') },
                // saureus scheme -> SCCmec only
                { assert ran('SCCMEC', 'TEST_SAUREUS') },
                { assert !ran('SCCMEC', 'TEST_KPNEUMONIAE') },
                { assert !ran('SCCMEC', 'TEST_SENTERICA') },
                { assert !ran('SCCMEC', 'TEST_OTHER') },
                // senterica_achtman_2 scheme -> SISTR only
                { assert ran('SISTR', 'TEST_SENTERICA') },
                { assert succeeded.count { it.contains('SISTR') } == 1 },
                // AMRFinderPlus runs for every sample; an organism (and so a
                // mutation report) only for the mapped schemes
                { assert ['TEST_KPNEUMONIAE', 'TEST_SAUREUS', 'TEST_SENTERICA', 'TEST_OTHER'].every { ran('AMRFINDERPLUS_RUN', it) } },
                { assert amrfinder('TEST_KPNEUMONIAE').exists() },
                { assert amrfinder('TEST_SAUREUS').exists() },
                { assert amrfinder('TEST_SENTERICA').exists() },
                { assert !amrfinder('TEST_OTHER').exists() },
                { assert nextflow_log.contains("Sample 'TEST_OTHER': MLST scheme 'none' has no AMRFinderPlus organism mapping") },
                { assert !nextflow_log.contains("Sample 'TEST_KPNEUMONIAE': MLST scheme") },
                { assert !nextflow_log.contains("Sample 'TEST_SAUREUS': MLST scheme") },
                { assert !nextflow_log.contains("Sample 'TEST_SENTERICA': MLST scheme") }
            )
        }

    }

    test("Species check agrees, overrides MLST and flags a sample without a reference hit - stub") {

        tag "pipeline"
        tag "stub"
        tag "species_check"

        options "-stub"
        config "./config/species_check.config"

        when {
            params {
                input        = "${projectDir}/tests/data/samplesheet_species_check.csv"
                seq_type     = "contig"
                species_refs = "${projectDir}/tests/data/skani"
                bakta_db     = "${projectDir}/tests/data/stub_db/bakta"
                amrfinder_db = "${projectDir}/tests/data/stub_db/amrfinderplus"
                outdir       = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            def ran = { process, sample -> succeeded.any { it.contains(":${process} (${sample})") } }
            def nextflow_log = path("${metaDir}/nextflow.log").text
            def table = path("$outputDir/pipeline_info/species_check.tsv").readLines()*.split('\t', -1)
            def rows = table.drop(1).collectEntries { row -> [ row[0], [ table[0] as List, row as List ].transpose().collectEntries() ] }
            def amrfinder = { sample -> path("$outputDir/${sample}/annotation/amrfinder/${sample}-mutations.tsv") }
            assertAll(
                { assert workflow.success },
                { assert ['TEST_AGREE', 'TEST_OVERRIDE', 'TEST_NOHIT'].every { ran('SKANI_SEARCH', it) && ran('SPECIES_CHECK', it) } },
                // agreement: MLST routing unchanged
                { assert rows.TEST_AGREE.decision == 'agree' },
                { assert rows.TEST_AGREE.organism == 'Klebsiella_pneumoniae' },
                { assert rows.TEST_AGREE.flagged == 'no' },
                { assert ran('KLEBORATE', 'TEST_AGREE') },
                // disagreement (the SCL2461 case): routed by the reference call, mlst again with its scheme
                { assert rows.TEST_OVERRIDE.mlst_scheme == 'ecoli_achtman_4' },
                { assert rows.TEST_OVERRIDE.mlst_organism == 'Escherichia' },
                { assert rows.TEST_OVERRIDE.skani_species == 'Klebsiella pneumoniae' },
                { assert rows.TEST_OVERRIDE.decision == 'override' },
                { assert rows.TEST_OVERRIDE.organism == 'Klebsiella_pneumoniae' },
                { assert rows.TEST_OVERRIDE.rerun_scheme == 'klebsiella' },
                { assert rows.TEST_OVERRIDE.flagged == 'yes' },
                { assert ran('KLEBORATE', 'TEST_OVERRIDE') },
                { assert ran('MLST_SCHEME', 'TEST_OVERRIDE') },
                { assert succeeded.count { it.contains(':MLST_SCHEME ') } == 1 },
                { assert path("$outputDir/TEST_OVERRIDE/annotation/mlst/TEST_OVERRIDE.klebsiella.tsv").exists() },
                { assert path("$outputDir/TEST_OVERRIDE/annotation/mlst/TEST_OVERRIDE.tsv").exists() },
                { assert nextflow_log.contains("Sample 'TEST_OVERRIDE': species check override - MLST scheme ecoli_achtman_4 does not type skani Klebsiella pneumoniae") },
                // no reference hit: MLST routing, flagged
                { assert rows.TEST_NOHIT.decision == 'mlst' },
                { assert rows.TEST_NOHIT.organism == 'Staphylococcus_aureus' },
                { assert rows.TEST_NOHIT.flagged == 'yes' },
                { assert rows.TEST_NOHIT.reason.startsWith('no reference hit') },
                { assert ran('SCCMEC', 'TEST_NOHIT') },
                { assert !ran('KLEBORATE', 'TEST_NOHIT') },
                // every sample gets an organism, so a point-mutation report
                { assert ['TEST_AGREE', 'TEST_OVERRIDE', 'TEST_NOHIT'].every { amrfinder(it).exists() } },
                { assert rows.keySet() == [ 'TEST_AGREE', 'TEST_NOHIT', 'TEST_OVERRIDE' ] as Set },
                { assert rows.values().every { it.seq_type == 'contig' } },
                { assert path("$outputDir/report/mgap_report.html").exists() }
            )
        }

    }

    test("Species check without --species_refs: routing follows MLST - stub") {

        tag "pipeline"
        tag "stub"
        tag "species_check"

        options "-stub"
        config "./config/species_check.config"

        when {
            params {
                input        = "${projectDir}/tests/data/samplesheet_species_check.csv"
                seq_type     = "contig"
                bakta_db     = "${projectDir}/tests/data/stub_db/bakta"
                amrfinder_db = "${projectDir}/tests/data/stub_db/amrfinderplus"
                outdir       = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            def ran = { process, sample -> succeeded.any { it.contains(":${process} (${sample})") } }
            def nextflow_log = path("${metaDir}/nextflow.log").text
            def table = path("$outputDir/pipeline_info/species_check.tsv").readLines()*.split('\t', -1)
            def rows = table.drop(1).collectEntries { row -> [ row[0], [ table[0] as List, row as List ].transpose().collectEntries() ] }
            assertAll(
                { assert workflow.success },
                { assert nextflow_log.contains("--species_refs not provided: skipping the species check") },
                { assert !succeeded.any { it.contains('SKANI_SEARCH') } },
                { assert !succeeded.any { it.contains('MLST_SCHEME') } },
                { assert rows.values().every { it.decision == 'mlst' && it.reason == 'no reference set (--species_refs)' } },
                // MLST alone routes the ecoli_achtman_4 sample as Escherichia, without Kleborate
                { assert rows.TEST_OVERRIDE.organism == 'Escherichia' },
                { assert !ran('KLEBORATE', 'TEST_OVERRIDE') },
                { assert ran('KLEBORATE', 'TEST_AGREE') },
                { assert ran('SCCMEC', 'TEST_NOHIT') }
            )
        }

    }

