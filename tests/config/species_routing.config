/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Stub MLST schemes per sample, so one stub run reaches every species branch
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Used with tests/data/samplesheet_species_routing.csv. Samples not listed get
    '-', mlst's no-scheme marker.
----------------------------------------------------------------------------------------
*/

process {
    withName: 'MLST' {
        ext.stub_scheme = {
            [
                TEST_KPNEUMONIAE: 'klebsiella',
                TEST_SAUREUS    : 'saureus'
            ][meta.id] ?: '-'
        }
    }
}
