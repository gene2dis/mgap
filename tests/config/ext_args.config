/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Record the ext.args each task resolves to, for stub tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Stubs do not run the tool command, so its arguments never reach .command.sh.
    The comment below lands in each task's .command.run; tests/lib/TaskArgs.groovy
    reads it back.
----------------------------------------------------------------------------------------
*/

process {
    withName: 'KRAKEN2|BRACKEN|FLYE|MASH_SKETCH|LRGE|PLASMID_CIRCULAR|MOBSUITE_TYPER|MEDAKA' {
        beforeScript = { "# ext.args: ${task.ext.args ?: ''}" }
    }
}
