/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Stub MLST schemes and skani hits per sample for the species check
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Used with tests/data/samplesheet_species_check.csv and --species_refs tests/data/skani
    (its species_refs.tsv lists the accessions below). SPECIES_CHECK runs its real script in
    stub runs, so the decisions and the routing that follows them are tested:
    TEST_AGREE     klebsiella scheme, K. pneumoniae reference hit       -> agree
    TEST_OVERRIDE  ecoli_achtman_4 scheme (the SCL2461 case), K. pneumoniae hit
                                                                        -> override, mlst --scheme klebsiella
    TEST_NOHIT     saureus scheme, no reference hit                     -> mlst, flagged
    TEST_SAMPLESHEET  no scheme, no hit, samplesheet species Salmonella enterica
                                                                        -> samplesheet (SISTR)
----------------------------------------------------------------------------------------
*/

process {
    withName: 'MLST' {
        ext.stub_scheme = {
            [
                TEST_AGREE   : 'klebsiella',
                TEST_OVERRIDE: 'ecoli_achtman_4',
                TEST_NOHIT   : 'saureus'
            ][meta.id] ?: '-'
        }
    }
    withName: 'MLST_SCHEME' {
        ext.stub_scheme = { meta.mlst_scheme }
    }
    withName: 'SKANI_SEARCH' {
        ext.stub_hit = {
            [
                TEST_AGREE   : [ 'genomes/GCF_006364295.1.fna', '99.08', '85.95', '87.55' ],
                TEST_OVERRIDE: [ 'genomes/GCF_006364295.1.fna', '99.11', '86.35', '86.55' ]
            ][meta.id]
        }
    }
}
