/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Stub runs with every annotation tool on, checking which FASTA each one reads
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    The stubs only touch files, so the annotation tools run in the small seqkit
    image instead of their own (about 20 GB together, more than a CI runner can
    pull in reasonable time). Their version lines come out empty; nothing here
    checks versions.
----------------------------------------------------------------------------------------
*/

includeConfig 'species_routing.config'

process {
    withName: 'CHECKM2|BAKTA|GTDBTK|GENOMAD|MOBSUITE_RECON|MOBSUITE_TYPER|PLASMIDFINDER|AMRFINDERPLUS_RUN|RGI_LOAD|RGI_MAIN|KLEBORATE|SCCMEC|SISTR' {
        container = 'biocontainers/seqkit:2.13.0--he881be0_0'
    }
}
