/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Stub fastp JSON with read stats (patched nf-core fastp stub)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    1 Gb after filtering: 200x of the MASH_SKETCH stub's 5 Mb genome, above the
    default --max_coverage of 150. 151 cycles: Bracken -r 150 with a database
    that has 100, 150 and 300.
----------------------------------------------------------------------------------------
*/

process {
    withName: 'FASTP' {
        ext.stub_total_bases  = 1000000000
        ext.stub_total_cycles = 151
    }
}
