/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Stub samples for the sample QC gate and per-sample failure handling (D-7)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Used with tests/sample_qc.nf.test. The patched fastp/fastplong stubs report
    100 Mb after filtering (above the default --min_bases of 50 Mb; 20x of the
    MASH_SKETCH stub's 5 Mb genome, so no subsampling), and 1 Mb for the *_LOW
    samples. A beforeScript that exits makes the task fail before its stub runs:
    *_FAIL samples fail with the tool's real exit status (SPAdes 21 on too few
    reads, Flye and Medaka 1, QUAST 4 with no contig >= 500 bp), *_OOM samples
    fail the first attempt the way an out-of-memory kill shows up for that tool.
----------------------------------------------------------------------------------------
*/

process {
    withName: 'FASTP|FASTPLONG' {
        ext.stub_total_bases = { meta.id.contains('_LOW') ? 1000000 : 100000000 }
    }
    withName: 'SPADES' {
        beforeScript = {
            meta.id == 'TEST_SPADES_FAIL' ? 'exit 21'
                : meta.id == 'TEST_SPADES_OOM' && task.attempt == 1 ? 'exit 247'
                : 'true'
        }
    }
    withName: 'FLYE' {
        beforeScript = {
            meta.id == 'TEST_FLYE_FAIL' ? 'exit 1'
                : meta.id == 'TEST_FLYE_OOM' && task.attempt == 1 ? 'echo "ERROR: Looks like the system ran out of memory" >&2; exit 1'
                : 'true'
        }
    }
    withName: 'MEDAKA' {
        beforeScript = {
            meta.id == 'TEST_MEDAKA_FAIL' ? 'exit 1'
                : meta.id == 'TEST_MEDAKA_OOM' && task.attempt == 1 ? 'exit 137'
                : 'true'
        }
    }
    withName: 'QUAST' {
        beforeScript = { meta.id == 'TEST_QUAST_FAIL' ? 'exit 4' : 'true' }
    }
}
