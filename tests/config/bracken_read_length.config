/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Bracken -r selection in stub runs
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    The stub Kraken2/Bracken database (tests/data/stub_db/kraken2) has 100, 150
    and 300 bp kmer distributions. The fastp stub reports 151 cycles (Bracken
    -r 150), or ext.stub_total_cycles from params.stub_read_cycles. Resolved
    ext.args are recorded for tests/lib/TaskArgs.groovy.
----------------------------------------------------------------------------------------
*/

includeConfig 'ext_args.config'

params {
    stub_read_cycles = 151
}

process {
    withName: 'FASTP' {
        ext.stub_total_bases  = 1000000000
        ext.stub_total_cycles = params.stub_read_cycles
    }
}
