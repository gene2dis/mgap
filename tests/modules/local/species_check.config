// the pipeline's ext.args for SPECIES_CHECK (conf/modules.config) with --seq_type illumina
process {
    withName: 'SPECIES_CHECK' {
        ext.args = { [
            '--seq-type illumina',
            '--min-ani 95',
            '--min-af 50',
            '--ani-margin 0.5',
            meta.species ? "--expected '${meta.species}'" : ''
        ].join(' ').trim() }
    }
}
