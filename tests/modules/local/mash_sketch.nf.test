nextflow_process {

    name "Test MASH_SKETCH module"
    script "../../../modules/local/mash/sketch/main.nf"
    process "MASH_SKETCH"

    tag "modules"
    tag "modules_local"
    tag "mash"
    tag "mash/sketch"

    test("MASH_SKETCH - estimate genome size - stub") {

        tag "stub"

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ],
                    [ file("${baseDir}/tests/data/stub_inputs/reads_1.fastq.gz", checkIfExists: true), file("${baseDir}/tests/data/stub_inputs/reads_2.fastq.gz", checkIfExists: true) ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.mash.size() == 1 },
                { assert process.out.stats.size() == 1 },
                { assert path(process.out.genome_size[0][1]).text.trim() == '5000000' },
                { assert process.out.versions }
            )
        }

    }

}
