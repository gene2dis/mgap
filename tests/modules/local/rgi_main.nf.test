nextflow_process {

    name "Test RGI_MAIN module"
    script "../../../modules/local/rgi/main/main.nf"
    process "RGI_MAIN"

    tag "modules"
    tag "modules_local"
    tag "rgi"
    tag "rgi/main"

    test("RGI_MAIN - AMR gene prediction - stub") {

        tag "stub"

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file('genome.fasta')
                ]
                input[1] = file('card')
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert file(process.out.tsv[0][1]).name == 'test.txt' },
                { assert file(process.out.json[0][1]).name == 'test.json' },
                { assert process.out.versions }
            )
        }

    }

}
