nextflow_process {

    name "Test AUTOCYCLER_COMBINE module"
    script "../../../../modules/local/autocycler/combine/main.nf"
    process "AUTOCYCLER_COMBINE"

    tag "modules"
    tag "modules_local"
    tag "autocycler"
    tag "autocycler/combine"

    test("AUTOCYCLER_COMBINE - combine resolved clusters - stub") {

        tag "stub"

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:true ],
                    file("${baseDir}/tests/data/stub_inputs/autocycler_out", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert file(process.out.fasta[0][1]).name == 'test.fasta' },
                { assert file(process.out.gfa[0][1]).name == 'test.gfa' },
                { assert process.out.versions }
            )
        }

    }

}
