nextflow_pipeline {

    name "Test the sample QC gate and per-sample failures (D-7)"
    script "../main.nf"

    tag "pipeline"
    tag "sample_qc"

    // Samplesheets are written per test (SampleStatus.samplesheet) so they can
    // point at the local test files. Stub failures come from tests/config/sample_qc.config.

    test("Illumina: passing, low-read, failing and out-of-memory samples - stub") {

        tag "stub"

        options "-stub"
        config "./config/sample_qc.config"

        when {
            params {
                def r1 = "${projectDir}/tests/data/stub_inputs/reads_1.fastq.gz"
                def r2 = "${projectDir}/tests/data/stub_inputs/reads_2.fastq.gz"
                input    = SampleStatus.samplesheet(outputDir, 'samplesheet.csv', 'sample,fastq_1,fastq_2',
                    [ 'TEST_PASS', 'TEST_LOW', 'TEST_SPADES_FAIL', 'TEST_SPADES_OOM', 'TEST_SPADES_MEMORY_LIMIT' ].collect { sample -> "${sample},${r1},${r2}" })
                seq_type = "illumina"
                outdir   = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            def status = SampleStatus.of(outputDir)
            def nextflow_log = path("$metaDir/nextflow.log").text
            assertAll(
                { assert workflow.success },
                { assert status.keySet() == [ 'TEST_PASS', 'TEST_LOW', 'TEST_SPADES_FAIL', 'TEST_SPADES_OOM', 'TEST_SPADES_MEMORY_LIMIT' ] as Set },
                { assert status.TEST_PASS.subMap('seq_type', 'status', 'stage', 'reason', 'filtered_bases', 'assembly_contigs') == [ seq_type: 'illumina', status: 'pass', stage: 'annotation', reason: '', filtered_bases: '100000000', assembly_contigs: '1' ] },
                // below --min_bases: no Kraken2, Mash or SPAdes
                { assert status.TEST_LOW.subMap('status', 'stage', 'reason', 'assembly_contigs') == [ status: 'skipped', stage: 'read_qc', reason: '1000000 bases after fastp, below --min_bases 50000000', assembly_contigs: '' ] },
                { assert !succeeded.any { it.contains('(TEST_LOW)') && !it.contains('FASTP') } },
                { assert nextflow_log.contains("Sample 'TEST_LOW': 1000000 bases after fastp, fewer than --min_bases 50000000") },
                // SPAdes exit 21 (issue #3): ignored, recorded, the others continue
                { assert status.TEST_SPADES_FAIL.subMap('status', 'stage', 'reason') == [ status: 'failed', stage: 'assembly', reason: 'SPAdes failed (task error; exit status in the run log)' ] },
                { assert !succeeded.any { it.contains('MLST (TEST_SPADES_FAIL)') } },
                // exit 247 (a SPAdes step killed): retried once, then passes
                { assert workflow.trace.tasks().count { it.name.contains('SPADES (TEST_SPADES_OOM)') } == 2 },
                { assert status.TEST_SPADES_OOM.status == 'pass' },
                { assert succeeded.any { it.contains('MLST (TEST_SPADES_OOM)') } },
                // exit 12 (SPAdes at its own --memory limit): retried once, then passes
                { assert workflow.trace.tasks().count { it.name.contains('SPADES (TEST_SPADES_MEMORY_LIMIT)') } == 2 },
                { assert status.TEST_SPADES_MEMORY_LIMIT.status == 'pass' },
                { assert nextflow_log.contains("Samples: 5 (3 pass, 1 skipped, 1 failed) - skipped: TEST_LOW (read_qc); failed: TEST_SPADES_FAIL (assembly).") }
            )
        }
    }

    test("ONT Flye: low-read, Flye, Berokka and Medaka failures and retries - stub") {

        tag "stub"

        options "-stub"
        config "./config/sample_qc.config"

        when {
            params {
                def reads = "${projectDir}/tests/data/stub_inputs/reads.fastq.gz"
                input    = SampleStatus.samplesheet(outputDir, 'samplesheet.csv', 'sample,fastq_1,fastq_2',
                    [ 'TEST_PASS', 'TEST_LOW', 'TEST_FLYE_FAIL', 'TEST_FLYE_OOM', 'TEST_BEROKKA_FAIL', 'TEST_MEDAKA_FAIL', 'TEST_MEDAKA_OOM' ].collect { sample -> "${sample},${reads}," })
                seq_type = "ont"
                outdir   = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            def status = SampleStatus.of(outputDir)
            assertAll(
                { assert workflow.success },
                { assert status.TEST_PASS.subMap('seq_type', 'status', 'stage') == [ seq_type: 'ont', status: 'pass', stage: 'annotation' ] },
                { assert status.TEST_LOW.subMap('status', 'stage', 'reason') == [ status: 'skipped', stage: 'read_qc', reason: '1000000 bases after fastplong, below --min_bases 50000000' ] },
                { assert !succeeded.any { it.contains('FLYE (TEST_LOW)') } },
                { assert status.TEST_FLYE_FAIL.subMap('status', 'stage', 'reason') == [ status: 'failed', stage: 'assembly', reason: 'Flye failed (task error; exit status in the run log)' ] },
                // Flye exits 1 on out-of-memory and says so in its log: retried
                { assert workflow.trace.tasks().count { it.name.contains('FLYE (TEST_FLYE_OOM)') } == 2 },
                { assert workflow.trace.tasks().count { it.name.contains('FLYE (TEST_FLYE_FAIL)') } == 1 },
                { assert status.TEST_FLYE_OOM.status == 'pass' },
                // a failed Berokka task is ignored: Medaka polishes the untrimmed Flye assembly
                { assert workflow.trace.tasks().count { it.name.contains('BEROKKA (TEST_BEROKKA_FAIL)') } == 1 },
                { assert succeeded.any { it.contains('MEDAKA (TEST_BEROKKA_FAIL)') } },
                { assert status.TEST_BEROKKA_FAIL.status == 'pass' },
                { assert path("$metaDir/nextflow.log").text.contains("Sample 'TEST_BEROKKA_FAIL': Berokka failed - Medaka polishes the untrimmed Flye assembly.") },
                { assert status.TEST_MEDAKA_FAIL.subMap('status', 'stage', 'reason') == [ status: 'failed', stage: 'polishing', reason: 'Medaka failed (task error; exit status in the run log)' ] },
                { assert !succeeded.any { it.contains('MLST (TEST_MEDAKA_FAIL)') } },
                { assert workflow.trace.tasks().count { it.name.contains('MEDAKA (TEST_MEDAKA_OOM)') } == 2 },
                { assert status.TEST_MEDAKA_OOM.status == 'pass' }
            )
        }
    }

    test("Contig mode: QUAST and ISEScan failures are warnings and the sample is annotated - stub") {

        tag "stub"

        options "-stub"
        config "./config/sample_qc.config"

        when {
            params {
                def fasta = "${projectDir}/tests/data/stub_inputs/genome.fasta"
                input    = SampleStatus.samplesheet(outputDir, 'samplesheet.csv', 'sample,fasta',
                    [ 'TEST_PASS', 'TEST_QUAST_FAIL', 'TEST_ISESCAN_FAIL', 'TEST_ISESCAN_OOM' ].collect { sample -> "${sample},${fasta}" })
                seq_type    = "contig"
                run_isescan = true
                outdir      = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            def status = SampleStatus.of(outputDir)
            assertAll(
                { assert workflow.success },
                { assert status.TEST_PASS.subMap('seq_type', 'status', 'stage', 'reason', 'input_reads', 'assembly_contigs', 'assembly_length') == [ seq_type: 'contig', status: 'pass', stage: 'annotation', reason: '', input_reads: '', assembly_contigs: '1', assembly_length: '4' ] },
                { assert status.TEST_QUAST_FAIL.subMap('status', 'stage', 'reason') == [ status: 'pass', stage: 'annotation', reason: 'QUAST failed' ] },
                { assert succeeded.any { it.contains('MLST (TEST_QUAST_FAIL)') } },
                { assert path("$metaDir/nextflow.log").text.contains("Sample 'TEST_QUAST_FAIL': QUAST failed") },
                // a failed ISEScan task is ignored: no ISEScan results, the run and report go on
                { assert workflow.trace.tasks().count { it.name.contains('ISESCAN (TEST_ISESCAN_FAIL)') } == 1 },
                { assert status.TEST_ISESCAN_FAIL.subMap('status', 'stage', 'reason') == [ status: 'pass', stage: 'annotation', reason: '' ] },
                { assert succeeded.any { it.contains('MLST (TEST_ISESCAN_FAIL)') } },
                { assert path("$metaDir/nextflow.log").text.contains("Sample 'TEST_ISESCAN_FAIL': ISEScan failed (exit status in the run log) - no insertion sequence results for this sample.") },
                { assert !path("$outputDir/TEST_ISESCAN_FAIL/annotation/isescan").exists() },
                { assert path("$outputDir/TEST_PASS/annotation/isescan/TEST_PASS.isescan.tsv").exists() },
                // exit 137 (out-of-memory kill): retried once, then passes
                { assert workflow.trace.tasks().count { it.name.contains('ISESCAN (TEST_ISESCAN_OOM)') } == 2 },
                { assert path("$outputDir/TEST_ISESCAN_OOM/annotation/isescan/TEST_ISESCAN_OOM.isescan.tsv").exists() },
                { assert !path("$metaDir/nextflow.log").text.contains("Sample 'TEST_ISESCAN_OOM': ISEScan failed") },
                { assert succeeded.any { it.contains('MGAP_REPORT') } },
                { assert path("$metaDir/nextflow.log").text.contains('Samples: 4 (4 pass, 0 skipped, 0 failed) - QUAST failed: 1 of 4 samples with an assembly (TEST_QUAST_FAIL).') }
            )
        }
    }

    test("Every sample that went into assembly failed: the run fails, the table is written - stub") {

        tag "stub"

        options "-stub"
        config "./config/sample_qc.config"

        when {
            params {
                def r1 = "${projectDir}/tests/data/stub_inputs/reads_1.fastq.gz"
                def r2 = "${projectDir}/tests/data/stub_inputs/reads_2.fastq.gz"
                input    = SampleStatus.samplesheet(outputDir, 'samplesheet.csv', 'sample,fastq_1,fastq_2',
                    [ 'TEST_LOW', 'TEST_SPADES_FAIL' ].collect { sample -> "${sample},${r1},${r2}" })
                seq_type = "illumina"
                outdir   = "$outputDir"
            }
        }

        then {
            def status = SampleStatus.of(outputDir)
            assertAll(
                { assert workflow.failed },
                { assert path("$metaDir/nextflow.log").text.contains("Every sample that went into assembly failed there (1)") },
                { assert path("$metaDir/nextflow.log").text.contains("Samples: 2 (0 pass, 1 skipped, 1 failed) - skipped: TEST_LOW (read_qc); failed: TEST_SPADES_FAIL (assembly).") },
                { assert status.TEST_LOW.status == 'skipped' },
                { assert status.TEST_SPADES_FAIL.status == 'failed' }
            )
        }
    }

    test("Every sample below --min_bases: skipped, the run succeeds - stub") {

        tag "stub"

        options "-stub"
        config "./config/sample_qc.config"

        when {
            params {
                def reads = "${projectDir}/tests/data/stub_inputs/reads.fastq.gz"
                input    = SampleStatus.samplesheet(outputDir, 'samplesheet.csv', 'sample,fastq_1,fastq_2', [ "TEST_LOW,${reads}," ])
                seq_type = "ont"
                outdir   = "$outputDir"
            }
        }

        then {
            def succeeded = workflow.trace.succeeded().collect { it.name }
            assertAll(
                { assert workflow.success },
                { assert SampleStatus.of(outputDir).TEST_LOW.status == 'skipped' },
                { assert !succeeded.any { it.contains('FLYE') } },
                { assert path("$metaDir/nextflow.log").text.contains("Samples: 1 (0 pass, 1 skipped, 0 failed)") }
            )
        }
    }

    //
    // Real data (no stub): issue #3 with 500 read pairs of the nf-core B. fragilis
    // test reads (126 kb after fastp), and issue #2 with an assembly of 400 contigs
    // of 300 bp (QUAST exits 4: no contig >= 500 bp)
    //

    test("Issue #3: too few reads are skipped at the --min_bases gate") {

        when {
            params {
                input    = SampleStatus.samplesheet(outputDir, 'samplesheet.csv', 'sample,fastq_1,fastq_2',
                    [ "TEST_TINY,${projectDir}/tests/data/tiny_reads/tiny_1.fastq.gz,${projectDir}/tests/data/tiny_reads/tiny_2.fastq.gz" ])
                seq_type = "illumina"
                outdir   = "$outputDir"
            }
        }

        then {
            def row = SampleStatus.of(outputDir).TEST_TINY
            assertAll(
                { assert workflow.success },
                { assert row.subMap('status', 'stage', 'input_reads', 'input_bases', 'input_mean_length') == [ status: 'skipped', stage: 'read_qc', input_reads: '1000', input_bases: '126000', input_mean_length: '126' ] },
                { assert row.reason ==~ /\d+ bases after fastp, below --min_bases 50000000/ },
                { assert !workflow.trace.tasks().any { it.name.contains('SPADES') } }
            )
        }
    }

    test("Issue #3: with --min_bases 0 SPAdes fails, the sample is recorded and the run fails") {

        when {
            params {
                input     = SampleStatus.samplesheet(outputDir, 'samplesheet.csv', 'sample,fastq_1,fastq_2',
                    [ "TEST_TINY,${projectDir}/tests/data/tiny_reads/tiny_1.fastq.gz,${projectDir}/tests/data/tiny_reads/tiny_2.fastq.gz" ])
                seq_type  = "illumina"
                min_bases = 0
                outdir    = "$outputDir"
            }
        }

        then {
            def spades = path("$metaDir/trace.csv").readLines().findAll { it.contains(':SPADES (') }
            assertAll(
                { assert workflow.failed },
                // SPAdes 4.1.0: "Invalid kmer coverage histogram", exit 21; not retried
                { assert spades.size() == 1 },
                { assert spades[0].split('\t')[5] == '21' },
                { assert SampleStatus.of(outputDir).TEST_TINY.subMap('status', 'stage', 'reason') == [ status: 'failed', stage: 'assembly', reason: 'SPAdes failed (task error; exit status in the run log)' ] },
                { assert path("$metaDir/nextflow.log").text.contains("Every sample that went into assembly failed there (1)") }
            )
        }
    }

    test("Issue #2: QUAST fails on a highly fragmented assembly, the run continues") {

        when {
            params {
                input    = SampleStatus.samplesheet(outputDir, 'samplesheet.csv', 'sample,fasta',
                    [ "TEST_FRAGMENTED,${projectDir}/tests/data/fragmented/fragmented.fasta.gz" ])
                seq_type = "contig"
                outdir   = "$outputDir"
            }
        }

        then {
            def quast = path("$metaDir/trace.csv").readLines().findAll { it.contains(':QUAST (') }
            assertAll(
                { assert workflow.success },
                { assert quast.size() == 1 },
                // trace.csv column 6: exit
                { assert quast[0].split('\t')[5] == '4' },
                { assert path("$metaDir/nextflow.log").text.contains('MultiQC is skipped') },
                { assert path("$metaDir/nextflow.log").text.contains('Samples: 1 (0 pass, 0 skipped, 1 failed) - failed: TEST_FRAGMENTED (annotation_input); QUAST failed: 1 of 1 samples with an assembly (TEST_FRAGMENTED).') },
                { assert SampleStatus.of(outputDir).TEST_FRAGMENTED.subMap('status', 'stage', 'reason', 'assembly_contigs', 'assembly_length', 'assembly_n50', 'annotation_contigs') == [ status: 'failed', stage: 'annotation_input', reason: 'no contig >= --min_contig_length 1000 bp; QUAST failed', assembly_contigs: '400', assembly_length: '120000', assembly_n50: '300', annotation_contigs: '0' ] }
            )
        }
    }
}
