+        name="\${name%.*}"
+        printf '%s\\t%s\\n' "\$f" "\$name" >> genomes_batchfile.tsv
+    done
+
     gtdbtk classify_wf \\
         ${args} \\
-        --genome_dir bins \\
+        --batchfile genomes_batchfile.tsv \\
         --prefix "${prefix}" \\
         --out_dir ${prefix} \\
