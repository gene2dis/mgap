/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run gene2dis/mgap -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 2,
        memory: '6.GB',
        time: '6.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data: tiny public Illumina reads from nf-core/test-datasets
    input    = "${projectDir}/assets/samplesheet_test.csv"
    seq_type = 'illumina'

    // Skip resource-intensive / DB-dependent steps for CI.
    // No database params are set, so CheckM2, Bakta, AMRFinderPlus and
    // geNomad are skipped automatically.
    run_kraken2     = false
    adjust_coverage = false
}
