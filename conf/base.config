/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    gene2dis/mgap Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high performance
    compute environments. Assumes that all software is installed and available on
    the PATH. Runs in `local` mode - all jobs will be run on the logged in environment.
----------------------------------------------------------------------------------------
*/

process {

    // Default resource requirements - automatically capped by resourceLimits
    cpus   = { 1 * task.attempt }
    memory = { 6.GB * task.attempt }
    time   = { 4.h * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    // Resource limits - prevents jobs from requesting more than available
    resourceLimits = [
        cpus: 30,
        memory: 256.GB,
        time: 240.h
    ]

    // Process-specific resource requirements
    // NOTE - Please try and re-use the labels below as much as possible.
    //        These labels are used and recognised by default in DSL2 files hosted on nf-core/modules.
    //        If possible, it would be nice to keep the same label naming convention when
    //        adding in your local modules too.
    // See https://www.nextflow.io/docs/latest/config.html#config-process-selectors
    withLabel:process_single {
        cpus   = { 1 }
        memory = { 6.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 2 * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 6 * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 12 * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h * task.attempt }
    }
    withLabel:process_long {
        time   = { 20.h * task.attempt }
    }
    withLabel:process_high_memory {
        cpus   = { 12 * task.attempt }
        memory = { 200.GB * task.attempt }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }

    // Assembler input is subsampled, so memory follows genome size (11.6 GB peak, NECAT,
    // for 5.9 Mb). An out-of-memory retry adds memory only: more threads would use more
    // of it. 16 h per attempt, as before. A time-limit kill is not retried on the local
    // executor; schedulers that report one as exit 140 (SGE, PBS) get the one retry,
    // with twice the time.
    withName:AUTOCYCLER_ASSEMBLY {
        cpus   = { 6 }
        memory = { 36.GB * task.attempt }
        time   = { 16.h * task.attempt }
    }

    // Raven assembles all of the sample's reads here, so memory grows with read depth
    // (17.8 GB peak for 1.47 Gb of ONT reads, 3.8 GB for 0.55 Gb; issue #17). Extra
    // threads barely help (about 2 cores busy), so an out-of-memory retry (36, 72,
    // then 108 GB) adds memory and time only.
    withName:AUTOCYCLER_GENOME_SIZE {
        cpus       = { 6 }
        memory     = { 36.GB * task.attempt }
        time       = { 12.h * task.attempt }
        maxRetries = 2
    }

    // ISEScan (label process_medium for its 6 CPUs): 19 min, 4 of 6 CPUs busy on average
    // and 1.3-1.9 GB peak on 5.5-6.0 Mb assemblies (Phase 9c), so memory is set from that
    // cpus pinned: the out-of-memory retry gets more memory, not more parallel workers
    withName:ISESCAN {
        cpus   = 6
        memory = { 4.GB * task.attempt }
    }
}
