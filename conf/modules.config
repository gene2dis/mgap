/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTP {
        ext.args = [
            "-q ${params.fastp_qualified_quality}",
            "--unqualified_percent_limit ${params.fastp_unqualified_percent_limit}",
            "--cut_front",
            "--cut_front_window_size ${params.fastp_cut_front_window_size}",
            "--cut_front_mean_quality ${params.fastp_cut_front_mean_quality}",
            "--cut_right",
            "--cut_right_window_size ${params.fastp_cut_right_window_size}",
            "--cut_right_mean_quality ${params.fastp_cut_right_mean_quality}",
            "--length_required ${params.fastp_reads_minlength}",
            "--detect_adapter_for_pe",
            "--n_base_limit ${params.fastp_n_base_limit}",
            "--trim_poly_g"
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/${meta.id}/read_processing/fastp" },
            mode: params.publish_dir_mode,
            pattern: "*.{html,json,fastq.gz}"
        ]
    }

    withName: MASH_SKETCH {
        // Genome size from read k-mers seen at least 3 times (-m 3 drops
        // sequencing-error k-mers; Shovill's settings): within -8 % to +11 % of
        // the assembled size, against 5-21 Mb with Mash's defaults
        ext.args = '-k 32 -m 3'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/read_processing/mash" },
            mode: params.publish_dir_mode,
            pattern: "*.{msh,mash_stats,genome_size}"
        ]
    }

    withName: KRAKEN2 {
        // --memory-mapping reads the database through the page cache instead of
        // loading it into each task's memory (identical reports; 2.5x faster per
        // sample, 438 -> 178 s on a cold cache; docs/benchmarks/coverage_2026-10-24.md).
        // Memory stays process_high: on a cold cache the task is charged the
        // database pages it reads. Off on AWS Batch and Google Batch (the
        // mgap_awsbatch and mgap_googlebatch profiles), where every task starts on
        // a fresh machine. Keyed on the executor because a profile cannot override
        // this file, which nextflow.config includes after the profiles.
        ext.args = { task.executor in ['awsbatch', 'google-batch'] ? '' : '--memory-mapping' }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/read_processing/kraken2" },
            mode: params.publish_dir_mode,
            pattern: "*.{txt,fastq.gz,fastq}"
        ]
    }

    withName: BRACKEN {
        // -r per sample from the reads' length and the database (subworkflows/local/illumina.nf)
        ext.args = { meta.bracken_read_length ? "-r ${meta.bracken_read_length}" : '' }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/read_processing/bracken" },
            mode: params.publish_dir_mode,
            pattern: "*.{tsv}"
        ]
    }

    withName: SEQTK_SAMPLE {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/read_processing/subsampled" },
            mode: params.publish_dir_mode,
            pattern: "*.{fastq.gz}"
        ]
    }

    withName: SPADES {
        ext.args = [
            "--isolate",
        ].join(' ').trim()
        // D-7: an out-of-memory exit is retried once with the next attempt's memory;
        // any other failure, or a second one, is ignored and the sample is recorded
        // as failed in sample_status.tsv (subworkflows/local/illumina.nf). spades.py
        // exits 12 (ENOMEM) when a step reaches the --memory limit the module sets
        // from task.memory, the usual case; 247 when a step is killed (SIGKILL), 137
        // when spades.py itself is (SPAdes 4.1.0).
        errorStrategy = { task.exitStatus in ((130..145) + 104 + 12 + 247) && task.attempt == 1 ? 'retry' : 'ignore' }
        maxRetries    = 1
        publishDir = [
            path: { "${params.outdir}/${meta.id}/assemblies" },
            mode: params.publish_dir_mode,
            pattern: "*.{scaffolds.fa.gz,contigs.fa.gz,assembly.gfa.gz,spades.log,warnings.log}"
        ]
    }

    withName: QUAST {
        // Label the assembly with the sample ID: the report (and MultiQC's QUAST
        // rows) otherwise names it after the FASTA file, and samples whose files
        // share a name would merge into one MultiQC row
        ext.args = { "--labels ${meta.id}" }
        // D-7: a QUAST failure (exit 4 when no contig is >= 500 bp, issue #2) is a
        // warning; the sample is still annotated (workflows/mgap.nf)
        errorStrategy = { task.exitStatus in ((130..145) + 104) && task.attempt == 1 ? 'retry' : 'ignore' }
        maxRetries    = 1
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc/quast" },
            mode: params.publish_dir_mode,
            pattern: "*.{tsv}"
        ]
    }

    withName: SEQKIT_FILTER {
        // The annotation FASTA every annotation and typing tool reads (D-4): contigs
        // >= --min_contig_length, renamed contig_1..N in input order, with the
        // original header kept as the description. Keep the rename: BAKTA's
        // --keep-contig-headers relies on these short, unique IDs
        ext.args  = "--min-len ${params.min_contig_length}"
        ext.args2 = "--pattern '^' --replacement 'contig_{nr} '"
        publishDir = [
            path: { "${params.outdir}/${meta.id}/assemblies/annotation_input" },
            mode: params.publish_dir_mode,
            pattern: "*.{fasta,tsv}"
        ]
    }

    withName: CHECKM2 {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/annotation/checkm2" },
            mode: params.publish_dir_mode,
            pattern: "*.{tsv}"
        ]
    }

    withName: MLST {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/annotation/mlst" },
            mode: params.publish_dir_mode,
            pattern: "*.{tsv}"
        ]
    }

    withName: GTDBTK {
        publishDir = [
            path: { "${params.outdir}/gtdbtk" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: BAKTA {
        // Contigs are already filtered to --min_contig_length and renamed contig_N
        // by SEQKIT_FILTER. --keep-contig-headers: Bakta (and AMRFinderPlus, which
        // reads Bakta's outputs) report the same contig IDs as every other tool.
        ext.args = [
            "--keep-contig-headers",
            "--skip-plot",
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/${meta.id}/annotation/bakta" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: AMRFINDERPLUS_RUN {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/annotation/amrfinder" },
            mode: params.publish_dir_mode,
            pattern: "*.tsv"
        ]
    }

    withName: RGI_LOAD {
        publishDir = [ enabled: false ]
    }

    withName: RGI_MAIN {
        ext.args = [
            "-t contig",
            "-a ${params.rgi_alignment_tool}",
            "-d wgs",
            params.rgi_include_loose.toString().toBoolean() ? '--include_loose' : '',
            params.rgi_include_nudge.toString().toBoolean() ? '--include_nudge' : '',
            params.rgi_low_quality.toString().toBoolean() ? '--low_quality' : ''
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/${meta.id}/annotation/rgi" },
            mode: params.publish_dir_mode,
            pattern: "*.{txt,json}"
        ]
    }

    withName: GENOMAD {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/annotation/genomad" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: KLEBORATE {
        // -p kpsc: K. pneumoniae species complex preset, required by Kleborate 3. Keep it when
        // overriding ext.args; the module stub writes this preset's output names.
        ext.args = '-p kpsc --trim_headers'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/annotation/kleborate" },
            mode: params.publish_dir_mode,
            pattern: "*.{txt}"
        ]
    }

    withName: SCCMEC {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/annotation/sccmec" },
            mode: params.publish_dir_mode,
            pattern: "*.tsv"
        ]
    }

    withName: SISTR {
        ext.args = '--qc'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/annotation/sistr" },
            mode: params.publish_dir_mode,
            pattern: "*.{tab,json,csv,fasta}"
        ]
    }

    withName: MOBSUITE_RECON {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/annotation/mobsuite" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) {
                    return null
                }
                // Strip the leading 'results/' directory emitted by mob_recon
                return filename.startsWith('results/') ? filename.substring('results/'.length()) : filename
            }
        ]
    }

    withName: PLASMID_CIRCULAR {
        // D-22: contig mode types every contig when no header says which ones are circular
        ext.args = { params.seq_type == 'contig' ? '--all-if-untagged' : '' }
        publishDir = [ enabled: false ]
    }

    withName: MOBSUITE_TYPER {
        // each circular contig is typed as its own plasmid (mob_recon reconstructs none from
        // complete ONT assemblies, issue #17)
        ext.args = '--multi'
        ext.prefix = { "${meta.id}_circular_mobtyper" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/annotation/mobsuite" },
            mode: params.publish_dir_mode,
            pattern: "*_circular_mobtyper.txt"
        ]
    }

    withName: PLASMIDFINDER {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/annotation/plasmidfinder" },
            mode: params.publish_dir_mode,
            pattern: "*.{json,txt,tsv,fsa}"
        ]
    }

    withName: PLASMID_CONSENSUS {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/annotation/plasmid_consensus" },
            mode: params.publish_dir_mode,
            pattern: "*.tsv"
        ]
    }

    withName: ISESCAN {
        // retry an out-of-memory failure once, then ignore it (as BEROKKA): the
        // sample has no ISEScan results and the run goes on (workflows/mgap.nf)
        errorStrategy = { task.exitStatus in ((130..145) + 104) && task.attempt == 1 ? 'retry' : 'ignore' }
        maxRetries    = 1
        publishDir = [
            path: { "${params.outdir}/${meta.id}/annotation/isescan" },
            mode: params.publish_dir_mode,
            pattern: "*.isescan.*"
        ]
    }

    withName: MGAP_REPORT {
        publishDir = [
            path: { "${params.outdir}/report" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: MULTIQC {
        ext.args = { params.multiqc_title ? "--title \"${params.multiqc_title}\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

    //
    // ONT long-read processing and assembly (Flye + Medaka, or Autocycler)
    //

    withName: FASTPLONG {
        ext.args = [
            "--length_required ${params.fastplong_min_read_length}",
            "--qualified_quality_phred ${params.fastplong_qualified_quality}",
            "--unqualified_percent_limit ${params.fastplong_unqualified_percent_limit}"
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/${meta.id}/read_processing/fastplong" },
            mode: params.publish_dir_mode,
            pattern: "*.{html,json,fastq.gz,log}"
        ]
    }

    withName: FLYE {
        // meta.genome_size is set only with --flye_asm_coverage (subworkflows/local/ont.nf)
        ext.args = { meta.genome_size ? "--asm-coverage ${params.flye_asm_coverage} --genome-size ${meta.genome_size}" : '' }
        // D-7: retry an out-of-memory failure once, then ignore it (as SPADES). Flye
        // exits 1 when one of its steps is killed and logs "Looks like the system ran
        // out of memory" to stderr, so the exit status alone does not tell
        errorStrategy = {
            // the logs are read only for exit 1, where the status alone does not tell
            def logged_out_of_memory = false
            if (task.exitStatus == 1) {
                try {
                    logged_out_of_memory = [ '.command.err', '.command.log' ]
                        .collect { name -> task.workDir?.resolve(name) }
                        .any { task_log -> task_log?.exists() && task_log.text.contains('Looks like the system ran out of memory') }
                } catch (Exception _error) {
                    // an unreadable log (e.g. a remote work directory): treat as not out of memory
                    logged_out_of_memory = false
                }
            }
            def out_of_memory = task.exitStatus in ((130..145) + 104) || logged_out_of_memory
            out_of_memory && task.attempt == 1 ? 'retry' : 'ignore'
        }
        maxRetries    = 1
        publishDir = [
            path: { "${params.outdir}/${meta.id}/assemblies/flye" },
            mode: params.publish_dir_mode,
            // nf-core flye gzips the assembly and graph
            pattern: "*.{log,txt,json,assembly.fasta.gz,assembly_graph.gfa.gz}"
        ]
    }

    withName: LRGE {
        // Genome size for Flye's --asm-coverage; fixed seed so a rerun gives the same estimate
        ext.args = '--seed 11'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/assemblies/lrge" },
            mode: params.publish_dir_mode,
            pattern: "*.genome_size.txt"
        ]
    }

    withName: BEROKKA {
        // only trim: no removal of contigs matching Berokka's control sequence
        // (a PacBio internal control), which would drop circular contigs only
        ext.args = "--filter ''"
        // retry an out-of-memory failure once, then ignore it: ont.nf falls back
        // to the untrimmed Flye assembly
        errorStrategy = { task.exitStatus in ((130..145) + 104) && task.attempt == 1 ? 'retry' : 'ignore' }
        maxRetries    = 1
        // the trimmed assembly is an intermediate (Medaka's output is published);
        // the table says what was trimmed
        publishDir = [
            path: { "${params.outdir}/${meta.id}/assemblies/berokka" },
            mode: params.publish_dir_mode,
            pattern: "*.berokka.tsv"
        ]
    }

    withName: MEDAKA {
        // -m must match the basecaller model; unset lets medaka pick its default
        ext.args = { params.medaka_model ? "-m ${params.medaka_model}" : '' }
        // D-7: retry an out-of-memory failure once, then ignore it (as SPADES); the
        // module exits 137 when the task's cgroup counted an out-of-memory kill
        errorStrategy = { task.exitStatus in ((130..145) + 104) && task.attempt == 1 ? 'retry' : 'ignore' }
        maxRetries    = 1
        publishDir = [
            path: { "${params.outdir}/${meta.id}/assemblies/medaka" },
            mode: params.publish_dir_mode,
            pattern: "*.{log,fasta,gfa,txt,json,fna}"
        ]
    }

    withName: DNAAPLER {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/assemblies/dnaapler" },
            mode: params.publish_dir_mode,
            pattern: "*.{log,fasta,gfa,txt,json,fna}"
        ]
    }

    withName: AUTOCYCLER_GENOME_SIZE {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/assemblies/autocycler/genome_size" },
            mode: params.publish_dir_mode,
            pattern: "*_genome_size.txt"
        ]
    }

    withName: AUTOCYCLER_SUBSAMPLE {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/assemblies/autocycler" },
            mode: params.publish_dir_mode,
            saveAs: { null }
        ]
    }

    withName: AUTOCYCLER_ASSEMBLY {
        // --read_type must stay when overriding ext.args
        ext.args = { "--read_type ${params.autocycler_read_type}" }
        // An out-of-memory exit (the module turns the helper's SIGKILL message into
        // 137) is retried once with the next attempt's memory; any other failure,
        // or a second one, is ignored - the consensus step works with whatever
        // assemblies succeeded. A sample whose assemblers ALL fail is reported by
        // the guard in ont.nf.
        errorStrategy = { task.exitStatus in ((130..145) + 104) && task.attempt == 1 ? 'retry' : 'ignore' }
        maxRetries    = 1
        publishDir = [
            path: { "${params.outdir}/${meta.id}/assemblies/autocycler" },
            mode: params.publish_dir_mode,
            saveAs: { null }
        ]
    }

    // Pin the custom autocycler-suite image (built from
    // docker/autocycler-suite/Dockerfile) by digest so the published tag
    // cannot silently drift from what the pipeline was tested with.
    // This is the only container definition for the AUTOCYCLER_* modules.
    // Tag 0.8.0, referenced by digest alone: Singularity/Apptainer reject a
    // reference with both a tag and a digest.
    withName: 'AUTOCYCLER_.*' {
        container = 'docker.io/microds/autocycler@sha256:48ca6289d9cced23a4e273dfb4ab7c667603cec3943edf40018ccab5020cbd44'
    }

    withName: AUTOCYCLER_CONSENSUS {
        // ext.args: compress, ext.args2: cluster, ext.args3: trim,
        // ext.args4: resolve, ext.args5: combine
        ext.args  = "--max_contigs ${params.autocycler_max_contigs}"
        ext.args2 = "--max_contigs ${params.autocycler_max_contigs}"
        publishDir = [
            path: { "${params.outdir}/${meta.id}/assemblies/autocycler" },
            mode: params.publish_dir_mode,
            pattern: "{autocycler_out,*.fasta,*.gfa}"
        ]
    }

    withName: AUTOCYCLER_GFA2FASTA {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/assemblies/dnaapler" },
            mode: params.publish_dir_mode,
            pattern: "*.fasta"
        ]
    }

}
