/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTP {
        ext.args = [
            "-q ${params.fastp_qualified_quality}",
            "--unqualified_percent_limit ${params.fastp_unqualified_percent_limit}",
            "--cut_front",
            "--cut_front_window_size ${params.fastp_cut_front_window_size}",
            "--cut_front_mean_quality ${params.fastp_cut_front_mean_quality}",
            "--cut_right",
            "--cut_right_window_size ${params.fastp_cut_right_window_size}",
            "--cut_right_mean_quality ${params.fastp_cut_right_mean_quality}",
            "--length_required ${params.fastp_reads_minlength}",
            "--detect_adapter_for_pe",
            "--n_base_limit ${params.fastp_n_base_limit}",
            "--trim_poly_g"
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/${meta.id}/read_processing/fastp" },
            mode: params.publish_dir_mode,
            pattern: "*.{html,json,fastq.gz}"
        ]
    }

    withName: MASH_SKETCH {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/read_processing/mash" },
            mode: params.publish_dir_mode,
            pattern: "*.{msh,mash_stats,mash_coverage}"
        ]
    }

    withName: KRAKEN2 {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/read_processing/kraken2" },
            mode: params.publish_dir_mode,
            pattern: "*.{txt,fastq.gz,fastq}"
        ]
    }

    withName: BRACKEN {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/read_processing/bracken" },
            mode: params.publish_dir_mode,
            pattern: "*.{tsv}"
        ]
    }

    withName: SEQTK_SAMPLE {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/read_processing/subsampled" },
            mode: params.publish_dir_mode,
            pattern: "*.{fastq.gz}"
        ]
    }

    withName: SPADES {
        ext.args = [
            "--isolate",
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/${meta.id}/assemblies" },
            mode: params.publish_dir_mode,
            pattern: "*.{scaffolds.fa.gz,contigs.fa.gz,assembly.gfa.gz,spades.log,warnings.log}"
        ]
    }

    withName: QUAST {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc/quast" },
            mode: params.publish_dir_mode,
            pattern: "*.{tsv}"
        ]
    }

    withName: SEQKIT_FILTER {
        // The annotation FASTA every annotation and typing tool reads (D-4): contigs
        // >= --min_contig_length, renamed contig_1..N in input order, with the
        // original header kept as the description. Keep the rename: BAKTA's
        // --keep-contig-headers relies on these short, unique IDs
        ext.args  = "--min-len ${params.min_contig_length}"
        ext.args2 = "--pattern '^' --replacement 'contig_{nr} '"
        publishDir = [
            path: { "${params.outdir}/${meta.id}/assemblies/annotation_input" },
            mode: params.publish_dir_mode,
            pattern: "*.{fasta,tsv}"
        ]
    }

    withName: CHECKM2 {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/annotation/checkm2" },
            mode: params.publish_dir_mode,
            pattern: "*.{tsv}"
        ]
    }

    withName: MLST {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/annotation/mlst" },
            mode: params.publish_dir_mode,
            pattern: "*.{tsv}"
        ]
    }

    withName: GTDBTK {
        publishDir = [
            path: { "${params.outdir}/gtdbtk" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: BAKTA {
        // Contigs are already filtered to --min_contig_length and renamed contig_N
        // by SEQKIT_FILTER. --keep-contig-headers: Bakta (and AMRFinderPlus, which
        // reads Bakta's outputs) report the same contig IDs as every other tool.
        ext.args = [
            "--keep-contig-headers",
            "--skip-plot",
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/${meta.id}/annotation/bakta" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: AMRFINDERPLUS_RUN {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/annotation/amrfinder" },
            mode: params.publish_dir_mode,
            pattern: "*.tsv"
        ]
    }

    withName: RGI_LOAD {
        publishDir = [ enabled: false ]
    }

    withName: RGI_MAIN {
        ext.args = [
            "-t contig",
            "-a ${params.rgi_alignment_tool}",
            "-d wgs",
            params.rgi_include_loose ? '--include_loose' : '',
            params.rgi_include_nudge ? '--include_nudge' : '',
            params.rgi_low_quality ? '--low_quality' : ''
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/${meta.id}/annotation/rgi" },
            mode: params.publish_dir_mode,
            pattern: "*.{txt,json}"
        ]
    }

    withName: GENOMAD {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/annotation/genomad" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: KLEBORATE {
        // -p kpsc: K. pneumoniae species complex preset, required by Kleborate 3. Keep it when
        // overriding ext.args; the module stub writes this preset's output names.
        ext.args = '-p kpsc --trim_headers'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/annotation/kleborate" },
            mode: params.publish_dir_mode,
            pattern: "*.{txt}"
        ]
    }

    withName: SCCMEC {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/annotation/sccmec" },
            mode: params.publish_dir_mode,
            pattern: "*.tsv"
        ]
    }

    withName: SISTR {
        ext.args = '--qc'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/annotation/sistr" },
            mode: params.publish_dir_mode,
            pattern: "*.{tab,json,csv,fasta}"
        ]
    }

    withName: MOBSUITE_RECON {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/annotation/mobsuite" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) {
                    return null
                }
                // Strip the leading 'results/' directory emitted by mob_recon
                return filename.startsWith('results/') ? filename.substring('results/'.length()) : filename
            }
        ]
    }

    withName: MULTIQC {
        ext.args = { params.multiqc_title ? "--title \"${params.multiqc_title}\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

    //
    // ONT long-read processing and assembly (Flye + Medaka, or Autocycler)
    //

    withName: FASTPLONG {
        ext.args = [
            "--length_required ${params.fastplong_min_read_length}",
            "--qualified_quality_phred ${params.fastplong_qualified_quality}",
            "--unqualified_percent_limit ${params.fastplong_unqualified_percent_limit}"
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/${meta.id}/read_processing/fastplong" },
            mode: params.publish_dir_mode,
            pattern: "*.{html,json,fastq.gz,log}"
        ]
    }

    withName: FLYE {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/assemblies/flye" },
            mode: params.publish_dir_mode,
            pattern: "*.{log,fasta,gfa,txt,json,fna}"
        ]
    }

    withName: MEDAKA {
        // -m must match the basecaller model; unset lets medaka pick its default
        ext.args = { params.medaka_model ? "-m ${params.medaka_model}" : '' }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/assemblies/medaka" },
            mode: params.publish_dir_mode,
            pattern: "*.{log,fasta,gfa,txt,json,fna}"
        ]
    }

    withName: DNAAPLER {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/assemblies/dnaapler" },
            mode: params.publish_dir_mode,
            pattern: "*.{log,fasta,gfa,txt,json,fna}"
        ]
    }

    withName: AUTOCYCLER_GENOME_SIZE {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/assemblies/autocycler/genome_size" },
            mode: params.publish_dir_mode,
            pattern: "*_genome_size.txt"
        ]
    }

    withName: AUTOCYCLER_SUBSAMPLE {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/assemblies/autocycler" },
            mode: params.publish_dir_mode,
            saveAs: { null }
        ]
    }

    withName: AUTOCYCLER_ASSEMBLY {
        // Individual assembler failures are tolerated - the Autocycler
        // consensus step works with whatever assemblies succeeded. A sample
        // whose assemblers ALL fail is reported by the guard in ont.nf.
        errorStrategy = 'ignore'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/assemblies/autocycler" },
            mode: params.publish_dir_mode,
            saveAs: { null }
        ]
    }

    // Pin the custom autocycler-suite image (built from
    // docker/autocycler-suite/Dockerfile) by digest so the published tag
    // cannot silently drift from what the pipeline was tested with.
    withName: 'AUTOCYCLER_.*' {
        container = 'docker.io/microds/autocycler:0.6.0@sha256:feb81239eac4ac7d660355be66efc9d8eabafbbca726a547d2443051f819369f'
    }

    withName: AUTOCYCLER_COMPRESS {
        ext.args = [
            "--max_contigs ${params.autocycler_max_contigs}",
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/${meta.id}/assemblies/autocycler" },
            mode: params.publish_dir_mode,
            pattern: "autocycler_out/**",
            saveAs: { fn -> fn.contains('/input_assemblies/') || fn.contains('/subsampled_reads/') ? null : fn }
        ]
    }

    withName: AUTOCYCLER_CLUSTER {
        ext.args = [
            "--max_contigs ${params.autocycler_max_contigs}",
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/${meta.id}/assemblies/autocycler" },
            mode: params.publish_dir_mode,
            pattern: "autocycler_out/**",
            overwrite: true,
            saveAs: { fn -> fn.contains('/input_assemblies/') || fn.contains('/subsampled_reads/') ? null : fn }
        ]
    }

    withName: AUTOCYCLER_TRIM_RESOLVE {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/assemblies/autocycler" },
            mode: params.publish_dir_mode,
            pattern: "autocycler_out/**",
            overwrite: true,
            saveAs: { fn -> fn.contains('/input_assemblies/') || fn.contains('/subsampled_reads/') ? null : fn }
        ]
    }

    withName: AUTOCYCLER_COMBINE {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/assemblies/autocycler" },
            mode: params.publish_dir_mode,
            pattern: "*.{fasta,gfa}"
        ]
    }

    withName: AUTOCYCLER_GFA2FASTA {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/assemblies/dnaapler" },
            mode: params.publish_dir_mode,
            pattern: "*.fasta"
        ]
    }

}
