/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Google Cloud Batch Configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Configuration for running the pipeline on Google Cloud Batch.
    Requires GCP credentials and proper IAM roles to be configured.
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Google Cloud Batch'
    config_profile_description = 'Google Cloud Batch profile for gene2dis/mgap pipeline'
}

process {
    executor = 'google-batch'

    // cpus, memory and time come from conf/base.config (with task.attempt
    // scaling); Nextflow picks the cheapest N2 machine type (standard,
    // highmem, highcpu) that fits each task's request
    machineType = 'n2-*'

    // KRAKEN2 runs without --memory-mapping on this executor (conf/modules.config)
}

google {
    project  = params.gcp_project ?: null
    location = params.gcp_region ?: 'us-central1'

    batch {
        spot = true
        bootDiskSize = 50.GB
    }
}

// Fusion filesystem for efficient GCS access
fusion {
    enabled = true
}

// Wave containers for on-demand container provisioning
wave {
    enabled = true
}

// Use Docker for GCP
docker {
    enabled   = true
    runOptions = '-u $(id -u):$(id -g)'
}
